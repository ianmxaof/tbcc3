# =============================================================================
# aof-forum env
# Copy to .env.local for local dev; set the same vars in Vercel for production.
# =============================================================================

# ----- Supabase (Project Settings -> API) -----
NEXT_PUBLIC_SUPABASE_URL=a
NEXT_PUBLIC_SUPABASE_ANON_KEY=ed
# Server-only: never expose to browser. Used by API route handlers and workers
# for privileged writes (ingest_jobs, view_events aggregation, sync upserts).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciU=r

# Magic-link redirect base (defaults to http://127.0.0.1:3001 in code). Set your public URL in production.
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001

# ----- Backblaze B2 (S3-compatible) -----
# Create an application key scoped to a single private bucket.
# Endpoint format: https://s3.<region>.backblazeb2.com  (find region in B2 console)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=aof-media-dev
B2_KEY_ID=
B2_APP_KEY=

# Public base URL for media. In dev this is the direct B2 friendly URL or a
# signed-URL service. In prod this becomes your Cloudflare CDN hostname,
# e.g. https://cdn.yourdomain.tld
NEXT_PUBLIC_MEDIA_BASE_URL=

# ----- Stash (local Docker, http://localhost:9999 by default) -----
# GraphQL endpoint is /graphql on the Stash host.
STASH_GRAPHQL_URL=http://localhost:9999/graphql
# Optional: set if you enabled Stash auth (Settings -> Security -> API Key)
STASH_API_KEY=
# Directory the ingest worker copies files into so Stash auto-imports them.
# Must be inside Stash's configured "Library Paths".
STASH_INBOX_DIR=C:/aof-media/stash-inbox

# ----- Ingest worker -----
# Folder watched for new files (drag-and-drop -> auto-ingest -> B2 -> DB).
INGEST_LOCAL_INBOX=C:/aof-media/inbox
# How often the worker polls (ms) when in --watch mode.
INGEST_POLL_MS=5000

# ----- tbcc (existing FastAPI backend) -----
# Used by workers/ingest from-telegram adapter and api/ingest from-url adapter
# (which proxies URL resolution through tbcc's crawler_resolver service).
TBCC_API_URL=http://localhost:8000
TBCC_INTERNAL_API_KEY=

# ----- Misc -----
# Used to sign cookies for anonymous session_ids that feed view_events
# (so the doom-scroll recommender can track sessions before users sign in).
SESSION_SIGNING_SECRET=change-me-to-a-long-random-string

# Cron: POST /api/reco/refresh — Authorization: Bearer <this value>
# Refreshes row hot scores and recommendation matviews (set in Vercel + never expose to client).
RECO_REFRESH_TOKEN=

# ----- One-shot mock seed (npm run seed:mock -- "D:\\path\\to\\images") -----
# Real auth user UUID with a profiles row (Supabase → Authentication → Users, or Table Editor → profiles).
MOCK_SEED_USER_ID=
# Optional: items per generated gallery (default 24), max files to scan (default 400).
# MOCK_SEED_ITEMS_PER_GALLERY=24
# MOCK_SEED_MAX_FILES=400
