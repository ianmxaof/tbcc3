{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_canonical": "Prefer telegram_bot2/.claude/settings.json when starting from repo root.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(py -3.13 -m pytest *)",
      "Bash(py -3.13 -m py_compile *)",
      "Bash(py -3.13 *)",
      "Bash(python *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(gh *)",
      "Bash(curl -sS https://api.powercore.app/*)",
      "Bash(curl -fsS https://api.powercore.app/*)",
      "Bash(ssh -o BatchMode=yes -o ConnectTimeout=* root@5.161.53.91 *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/revenue-island/deploy-island-live.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tbcc-stack-cli.ps1 -Action Status*)",
      "Bash(npx --no-install tsc *)",
      "Bash(npx --no-install next lint *)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(ffmpeg *)",
      "Bash(node --test extension/tests/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(../**/.env)",
      "Read(../**/.env.*)",
      "Read(./**/*.session)",
      "Read(./**/*.session-journal)",
      "Read(./.tbcc-run/**)",
      "Bash(*tbcc-stack-cli* Start*)",
      "Bash(*tbcc-stack-cli* Restart*)",
      "Bash(*python -m bots.payment_bot*)",
      "Bash(*python -m bots.loot_bot*)",
      "Bash(*python -m bots.secretary_bot*)",
      "Bash(*python -m bots.companion_bot*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)"
    ],
    "additionalDirectories": [
      "backend",
      "extension",
      "dashboard",
      "../aof-forum",
      "../aof-forum/app",
      "../aof-forum/lib",
      "../aof-forum/components"
    ]
  },
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "TBCC_BOT_RUNTIME_ADAPTER": "command"
  }
}
