# Remote TBCC worker — scrape queue only (offload Telethon from home PC).
# Copy to tbcc/infra/.env.remote-worker and fill in Tailscale IPs / secrets.
#
# Home stack must set TBCC_CELERY_HOME_QUEUES=celery,subscription,telegram
# so only ONE machine consumes the scrape queue (this VM).

# --- Reach home Postgres + Redis (Tailscale recommended) ---
# Example: home PC Tailscale IP 100.x.x.x with Docker infra bound to tailscale0
DATABASE_URL=postgresql://postgres:postgres@100.64.0.1:5432/tbcc
REDIS_URL=redis://100.64.0.1:6379/0

# --- Telegram (same account as home scraper.session) ---
API_ID=
API_HASH=

# Session files live under ./data/sessions/ (mounted into container)
TBCC_SCRAPER_TELEGRAM_SESSION=/data/sessions/scraper

# Scraper policy (match home)
TBCC_SCRAPER_FORWARD_ONLY=1
TBCC_SCRAPER_SKIP_NOFORWARD=1
TBCC_TELEGRAM_SQLITE_BUSY_TIMEOUT_MS=120000

# Optional: second Telethon worker on same VM (poster.session copy from home)
# TBCC_REMOTE_POST_WORKER=1
# TBCC_POSTER_TELEGRAM_SESSION=/data/sessions/admin_poster
