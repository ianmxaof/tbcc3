# TBCC revenue island — copy to tbcc/infra/.env.revenue-island on the dedicated VPS.
# Do NOT put this file on the scrape e2-micro. Do NOT commit real secrets.

# --- Image ---
TBCC_WORKER_IMAGE=ghcr.io/ianmxaof/tbcc-worker:latest

# --- Local Postgres / Redis (compose service names) ---
POSTGRES_DB=tbcc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql://postgres:change-me-strong@postgres:5432/tbcc
REDIS_URL=redis://redis:6379/0

# --- Public API (Cloudflare Tunnel / HTTPS hostname for webhooks) ---
# Gumroad Ping, NOWPayments IPN, etc. must hit this host — not home.
# See docs/AOF_FORUM_DOMAIN.md — prefer https://api.<aof-forum-domain>
TBCC_API_PUBLIC_URL=https://api.example.com
TBCC_API_URL=http://api:8000
# Require X-TBCC-Internal-Key on mutating routes (keep 0 until extension key is set).
TBCC_API_REQUIRE_INTERNAL=0

# --- Internal ---
TBCC_INTERNAL_API_KEY=
TBCC_BYPASS_API_KEY=
TBCC_BYPASS_ENABLED=0

# --- Link gates (flywheel ingest order) ---
TBCC_LINK_GATE_PROVIDERS=linkvertise,admaven,workink
TBCC_LINK_GATE_ROTATION=first
# TBCC_LINKVERTISE_PUBLISHER_ID=
# TBCC_WORKINK_BASE_LINK=
# TBCC_ADMAVEN_API_TOKEN=
# TBCC_PIXELDRAIN_API_KEY=

# --- Payment bot ---
BOT_TOKEN=
TBCC_PAYMENT_BOT_USERNAME=

# --- Loot bot ---
TBCC_LOOT_BOT_TOKEN=
# Animated reveal cards (ffmpeg mux over background loops in loot_tier_cards/backgrounds/)
TBCC_LOOT_REVEAL_VIDEO=1
TBCC_LOOT_REVEAL_VIDEO_CELERY=1
# TBCC_LOOT_REVEAL_VIDEO_SECONDS=4
# TBCC_LOOT_REVEAL_VIDEO_SIZE=512
# TBCC_LOOT_REVEAL_VIDEO_TIMEOUT_S=12

# --- Telegram API (if any island workers need Telethon; scrape stays on GCP micro) ---
API_ID=
API_HASH=
ADMIN_TELEGRAM_ID=

# --- R2 (media source of truth when home is off) ---
TBCC_R2_ACCOUNT_ID=
TBCC_R2_BUCKET=aof-media
TBCC_R2_PUBLIC_BASE_URL=
TBCC_R2_S3_ENDPOINT=
# TBCC_R2_ACCESS_KEY_ID=
# TBCC_R2_SECRET_ACCESS_KEY=
# Or token-based upload vars used by your current scripts — mirror home .env R2 block.

# --- Gumroad / external pay (webhooks terminate on island API) ---
# TBCC_GUMROAD_CHECKOUT_ENABLED=1
# TBCC_GUMROAD_SELLER_ID=
# TBCC_GUMROAD_PRODUCT_URL=
# TBCC_GUMROAD_PRODUCT_MAP=

# --- Sale announce / loot promo (consumed on island `celery` queue) ---
# TBCC_SALE_ANNOUNCE_ENABLED=1
# TBCC_SALE_ANNOUNCE_TARGETS=network,buffer   # buffer = Buffer → X (PRIMARY channel)
# TBCC_SALE_ANNOUNCE_BUFFER_MODE=shareNow      # shareNow = post immediately on sale; addToQueue = Buffer queue
# TBCC_SALE_ANNOUNCE_MIN_INTERVAL_S=45
# TBCC_SALE_ANNOUNCE_SKIP_KEYS=
# Poster session (worker_post compose defaults):
#   TBCC_POSTER_TELEGRAM_SESSION=/sessions/admin_poster
#   TBCC_POSTER_AUTO_COPY_ADMIN_SESSION=1
# Import / Storage Hub → pool → SENT CACHE (also baked into docker-compose worker.environment):
#   TBCC_IMPORT_TELEGRAM_SESSION=/sessions/admin_import
#   TBCC_IMPORT_AUTO_COPY_ADMIN_SESSION=1
#   TBCC_STORAGE_POOL_SEED_ENABLED=1
#   TBCC_STORAGE_POOL_SEED_BATCH=12
#   TBCC_STORAGE_POOL_SEED_HOURS=2
# Without IMPORT_* under /sessions, deposits fail on admin_import.session and lanes never drain.
# Dual X lanes (Buffer):
#   TBCC_BUFFER_CHANNEL_ID_PRIMARY=…          # Loot Room → wizardstick69
#   TBCC_BUFFER_CHANNEL_ID_X_SECONDARY=…      # AOF VIP → PowerCoreAi
#   TBCC_BUFFER_API_KEY=… TBCC_BUFFER_ORGANIZATION_ID=…

# Island must NOT consume scrape (leave scrape on GCP micro / home Redis for now).
# workers: worker (-Q celery,subscription,telegram) + worker_post (-Q post_scheduler,post)