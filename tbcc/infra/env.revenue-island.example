# TBCC revenue island — copy to tbcc/infra/.env.revenue-island on the dedicated VPS.
# Do NOT put this file on the scrape e2-micro. Do NOT commit real secrets.

# --- Image ---
TBCC_WORKER_IMAGE=ghcr.io/ianmxaof/tbcc-worker:latest

# --- Local Postgres / Redis (compose service names) ---
POSTGRES_DB=tbcc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql://postgres:change-me-strong@postgres:5432/tbcc
# Redis requires auth (loopback-only bind + requirepass — see docker-compose.revenue-island.yml).
# REDIS_URL must embed the SAME password as TBCC_REDIS_PASSWORD (celery/redis-py read REDIS_URL
# directly; dotenv does not expand ${VAR} references, so it cannot just point at the other key).
TBCC_REDIS_PASSWORD=change-me-strong-too
REDIS_URL=redis://:change-me-strong-too@redis:6379/0

# --- Public API (Cloudflare Tunnel / HTTPS hostname for webhooks) ---
# Gumroad Ping, NOWPayments IPN, etc. must hit this host — not home.
# See docs/AOF_FORUM_DOMAIN.md — prefer https://api.<aof-forum-domain>
TBCC_API_PUBLIC_URL=https://api.example.com
TBCC_API_URL=http://api:8000
# Require X-TBCC-Internal-Key on mutating routes (keep 0 until extension key is set).
TBCC_API_REQUIRE_INTERNAL=0

# --- Internal ---
TBCC_INTERNAL_API_KEY=
TBCC_BYPASS_API_KEY=
TBCC_BYPASS_ENABLED=0

# --- Link gates (flywheel ingest order) ---
TBCC_LINK_GATE_PROVIDERS=linkvertise,admaven,workink
TBCC_LINK_GATE_ROTATION=first
# TBCC_LINKVERTISE_PUBLISHER_ID=
# TBCC_WORKINK_BASE_LINK=
# TBCC_ADMAVEN_API_TOKEN=
# TBCC_PIXELDRAIN_API_KEY=

# --- Payment bot ---
BOT_TOKEN=
TBCC_PAYMENT_BOT_USERNAME=

# --- Companion bot (@aof_spicybot_bot) — LLM chat + undress image jobs ---
# Webhooks: {TBCC_API_PUBLIC_URL}/webhooks/companion/undress (API container, not this bot).
# TBCC_COMPANION_BOT_TOKEN=
# TBCC_COMPANION_BOT_USERNAME=aof_spicybot_bot
# TBCC_UNDRESS_TOOL_API_KEY=
# TBCC_UNDRESS_TOOL_BASE_URL=https://public-api.undresstool.fun
# TBCC_COMPANION_IMAGE_PROVIDER=undress
# TBCC_COMPANION_FREE_TRIAL_PHOTOS=1
# TBCC_COMPANION_STARS_ENABLED=1
# TBCC_COMPANION_STARS_PER_PHOTO=25
# TBCC_COMPANION_VIDEO_ENABLED=1
# TBCC_COMPANION_VIDEO_CREDIT_UNITS=2
# TBCC_COMPANION_GATE_ENABLED=1
# After trial exhausted → send users to affiliate undress (free credits lane while spicybot catches up):
# TBCC_COMPANION_AFFILIATE_UNDRESS_URL=https://nodress.site/tg/bot?username=Aifasteditbot&ref_id=YOUR_ID
# TBCC_AFFILIATE_UNDRESS_URL=   # same ref for Buffer X {affiliate} placeholders
#
# LLM for companion (no Ollama on island — use OpenAI-compatible API):
# TBCC_LLM_CHAT_PROVIDER=custom
# TBCC_LLM_BASE_URL=https://api.hcnsec.cn/v1
# TBCC_LLM_API_KEY=sk-...        # from hcnsec dashboard — never commit
# TBCC_LLM_MODEL=...             # pick from their Model Square (uncensored id)
# TBCC_COMPANION_SYSTEM_PROMPT=    # optional persona override
# TBCC_LLM_CHAT_MAX_TOKENS=512
# TBCC_LLM_CHAT_TEMPERATURE=0.9
# Smoke LLM from laptop: cd backend && py -3.13 scripts/tbcc_uncensored_chat.py -p custom --verify

# --- Loot bot ---
TBCC_LOOT_BOT_TOKEN=
# Animated reveal cards (ffmpeg mux over background loops in loot_tier_cards/backgrounds/)
TBCC_LOOT_REVEAL_VIDEO=1
TBCC_LOOT_REVEAL_VIDEO_CELERY=1
TBCC_LOOT_BORDER_REVEAL=1
# Auto-crop letterboxed magenta gutters to chrome bbox on import + at roll-time mux (default on)
# TBCC_LOOT_BORDER_AUTO_CROP=1
# TBCC_LOOT_BORDER_OPEN_SECONDS=1.6
# TBCC_LOOT_REVEAL_VIDEO_SECONDS=4
# TBCC_LOOT_REVEAL_VIDEO_SIZE=512
# TBCC_LOOT_REVEAL_VIDEO_TIMEOUT_S=12

# --- Telegram API (if any island workers need Telethon; scrape stays on GCP micro) ---
API_ID=
API_HASH=
ADMIN_TELEGRAM_ID=

# --- R2 (media source of truth when home is off) ---
TBCC_R2_ACCOUNT_ID=
TBCC_R2_BUCKET=aof-media
TBCC_R2_PUBLIC_BASE_URL=
TBCC_R2_S3_ENDPOINT=
# TBCC_R2_ACCESS_KEY_ID=
# TBCC_R2_SECRET_ACCESS_KEY=
# Dedicated X promo bucket (aof-x-promo — NOT aof-media / media.powercore.app):
# TBCC_X_PROMO_R2_BUCKET=aof-x-promo
# TBCC_X_PROMO_R2_PUBLIC_BASE_URL=https://pub-0b25a74ea7714db386ae4fe73e611141.r2.dev
# TBCC_X_PROMO_R2_PREFIX=upl2cf  aof-x-promo/
# Or token-based upload vars used by your current scripts — mirror home .env R2 block.

# --- Gumroad / external pay (webhooks terminate on island API) ---
# TBCC_GUMROAD_CHECKOUT_ENABLED=1
# TBCC_GUMROAD_SELLER_ID=
# TBCC_GUMROAD_PRODUCT_URL=
# TBCC_GUMROAD_PRODUCT_MAP=

# --- Sale announce / loot promo (consumed on island `celery` queue) ---
# TBCC_SALE_ANNOUNCE_ENABLED=1
# TBCC_SALE_ANNOUNCE_TARGETS=network,buffer   # buffer = Buffer → X (PRIMARY channel)
# TBCC_SALE_ANNOUNCE_BUFFER_MODE=shareNow      # shareNow = post immediately on sale; addToQueue = Buffer queue
# TBCC_SALE_ANNOUNCE_MIN_INTERVAL_S=45
# TBCC_SALE_ANNOUNCE_SKIP_KEYS=
# Poster session (worker_post compose defaults):
#   TBCC_POSTER_TELEGRAM_SESSION=/sessions/admin_poster
#   TBCC_POSTER_AUTO_COPY_ADMIN_SESSION=1
# Import / Storage Hub → pool → SENT CACHE (also baked into docker-compose worker.environment):
#   TBCC_IMPORT_TELEGRAM_SESSION=/sessions/admin_import
#   TBCC_IMPORT_AUTO_COPY_ADMIN_SESSION=1
#   TBCC_STORAGE_POOL_SEED_ENABLED=1
#   TBCC_STORAGE_POOL_SEED_BATCH=12
#   TBCC_STORAGE_POOL_SEED_HOURS=2
# Without IMPORT_* under /sessions, deposits fail on admin_import.session and lanes never drain.
# Dual X lanes (Buffer):
#   TBCC_BUFFER_CHANNEL_ID_PRIMARY=…          # Loot Room → wizardstick69
#   TBCC_BUFFER_CHANNEL_ID_X_SECONDARY=…      # AOF VIP → PowerCoreAi
#   TBCC_BUFFER_API_KEY=… TBCC_BUFFER_ORGANIZATION_ID=…
# SFW deals silo (The Checkout List — Phase 1+):
#   TBCC_CHECKOUT_LIST_CHANNEL_IDENT=-1004361597444

# Island must NOT consume batch pool scrape (leave on GCP micro / home).
# workers: worker (celery,subscription,ops_*) + worker_telegram (telegram) + worker_post (post*)
# Volume path = Storage Hub → R2 (not scrape-scheduler / micro-pull drip).

TBCC_REVENUE_ISLAND_ACTIVE=1
TBCC_SCRAPE_SCHEDULER_ENABLED=0
TBCC_SCRAPE_MICRO_PULL_ENABLED=0
TBCC_MARKET_INTEL_PROBE_ENABLED=0
TBCC_MARKET_INTEL_CYCLE_ENABLED=0
TBCC_STORAGE_HUB_R2_EXPORT_ENABLED=1
# TBCC_STORAGE_HUB_R2_EXPORT_MINUTES=10
# TBCC_STORAGE_HUB_R2_EXPORT_LIMIT=15

# --- Gatekeeper + hub-first (when scrape consumer is elsewhere) ---
TBCC_SCRAPE_HUB_FIRST=1
# Opt-in drip only if you re-enable a scrape consumer:
# TBCC_SCRAPE_MICRO_PULL_ENABLED=1
# TBCC_SCRAPE_MICRO_PULL_MODE=firehose
# TBCC_SCRAPE_MICRO_PULL_DEDUPE=1
# TBCC_SCRAPE_MICRO_PULL_LIMIT=10
TBCC_GATEKEEPER_REVIEW_BOT=payment
TBCC_GATEKEEPER_REVIEW_COPY_MEDIA=1
# Create "Gatekeeper Review" forum topic in Storage Hub, then set its message_thread_id:
# TBCC_GATEKEEPER_REVIEW_THREAD_ID=1
TBCC_GATEKEEPER_HUB_AUTO_APPROVE=1
TBCC_GATEKEEPER_HUB_AUTO_APPROVE_MIN=70
TBCC_GATEKEEPER_HUB_REQUIRE_LANE_DETECT=1
TBCC_GATEKEEPER_APPROVE_MICRO_PULL=1
TBCC_GATEKEEPER_LANE_PICKER=1
# Storage-deposit auto-approve — TBCC_GATEKEEPER_HUB_AUTO_APPROVE above and
# this one both default to "1" in code (hub_intake_policy._env_auto_approve_default);
# pinned here so the intent is explicit and doesn't drift silently.
TBCC_STORAGE_DEPOSIT_AUTO_APPROVE=1

# --- Inbox-intake pipeline (2026-08-22 hardening — see
# tbcc/docs/handoffs/2026-08-22_inbox-intake-pipeline-hardening_report.md) ---
# Blunt global kill-switch that paused ALL pool auto-post whenever ANY of ~50
# schedulers anywhere was overdue — redundant with the still-active granular
# per-pool block (_pool_ids_blocked_by_overdue_schedulers). Off = safe default.
TBCC_POOL_AUTOPOST_PAUSE_WHEN_OVERDUE=0
# Enables the standing classify/enrich hook on every real Telegram deposit
# (auto_tag_enrich.run_auto_tag_enrich_for_media, called from
# _post_media_ingest). Off/unset = nothing auto-classifies, ever.
TBCC_ENRICH_ON_IMPORT=1
# Validated reliable end-to-end (~$0.0002/image); the free tier
# (nemotron-nano-12b-v2-vl:free) hits 429s and occasional refusals at volume.
TBCC_VISION_LLM_PROVIDER=openrouter
TBCC_VISION_LLM_MODEL=qwen/qwen3-vl-235b-a22b-instruct
# Comma-separated lane allowlist for hands-off auto-route (media_lane_vision_classify
# decision -> gatekeeper_review.enqueue_lane_route_for_media). Unset/empty = fully
# inert — everything still lands as a suggestion for the Q&A panel. Only add a lane
# here once it has real validated ground-truth accuracy.
TBCC_VISION_AUTO_ROUTE_LANES=voyeur,bop

# Module A — daily free pull (enable after attribution smoke; operator may set on home .env)
# TBCC_LOOT_DAILY_PULL_ENABLED=1
# TBCC_LOOT_DAILY_PULL_MAX_TIER=2

# Click beacon — default: log hits, no instant Telegram spam from curl/TG previews
# TBCC_CLICK_BEACON_INSTANT=0
# TBCC_CLICK_BEACON_NOTIFY_BOTS=0

# Kit buyer email capture (Gumroad ping → Kit v4 API). Secret: kit.com/settings/api
# TBCC_KIT_CAPTURE_ENABLED=0
# TBCC_KIT_API_SECRET=
# TBCC_KIT_PURCHASE_TAG_ID=
# --- Always-on UI (compose profile: ui) — dashboard + AOF Forum on the VPS ---
# See docs/ISLAND_UI_SURFACES.md
# TBCC_DASHBOARD_PUBLIC_URL=https://dash.powercore.app
# TBCC_FORUM_PUBLIC_URL=https://forum.powercore.app
# TBCC_ADMIN_BRIDGE_SECRET=  # optional; falls back to TBCC_INTERNAL_API_KEY
# Prefer Cloudflare Access on dash.* (nginx injects internal API key).
#
# Forum (Supabase) — required when --profile ui runs forum:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_BRIDGE_EMAIL=you@example.com
# ADMIN_BRIDGE_USER_ID=
# MOCK_SEED_USER_ID=
