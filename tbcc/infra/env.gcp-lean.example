# TBCC lean stack on GCP VPS — copy to tbcc/infra/.env.gcp-lean
# Never commit secrets. Sync from home: scripts/gcp/sync-stack-to-gcp.ps1

# --- Stack mode ---
TBCC_STACK_PROFILE=lean
TBCC_BOT_RUNTIME_ADAPTER=command

# --- Infra (Docker service names — do not use localhost here) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/tbcc
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- API ---
TBCC_API_URL=http://api:8000
TBCC_INTERNAL_API_KEY=
TBCC_UVICORN_RELOAD=0

# --- Telegram core ---
API_ID=
API_HASH=
ADMIN_TELEGRAM_ID=

# --- Telethon sessions (mounted at /data/sessions in containers) ---
TELEGRAM_SESSION_PATH=/data/sessions/admin
TBCC_POSTER_TELEGRAM_SESSION=/data/sessions/admin_poster
TBCC_IMPORT_TELEGRAM_SESSION=/data/sessions/admin_import
TBCC_ALBUM_COMPOSER_TELEGRAM_SESSION=/data/sessions/admin_album
TBCC_SCRAPER_TELEGRAM_SESSION=/data/sessions/scraper
TBCC_TELEGRAM_ACCOUNT_LOCK=1
TBCC_TELEGRAM_LOCK_TIMEOUT_S=300
TBCC_TELEGRAM_SQLITE_BUSY_TIMEOUT_MS=120000

# --- Bots (lean stack) ---
BOT_TOKEN=
TBCC_PAYMENT_BOT_USERNAME=
TBCC_SECRETARY_BOT_TOKEN=
TBCC_LOOT_BOT_TOKEN=
TBCC_ALBUM_COMPOSER_BOT_TOKEN=

# --- Celery (full scrape on VPS — no home/remote split) ---
TBCC_CELERY_HOME_QUEUES=celery,scrape,subscription,telegram

# --- Public URL for webhooks / media (Cloudflare tunnel or your domain) ---
# TBCC_PUBLIC_API_URL=https://api.yourdomain.com
# TBCC_MEDIA_PUBLIC_BASE_URL=https://api.yourdomain.com

# --- Optional LLM / enrichment (disable on small VMs) ---
TBCC_SKIP_ENRICHMENT=1
