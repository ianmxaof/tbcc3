{
  "name": "fetlife-suite",
  "version": "1.1.3",
  "header": {
    "name": "TBCC FetLife Suite",
    "namespace": "https://github.com/tbcc/userscripts/fetlife",
    "description": "FetLife suite: masonry, story filter, mute, gender filter, auto-follow+scroll, San Jose kinksters redirect, TBCC chevron overlay.",
    "match": [
      "https://fetlife.com/*",
      "https://www.fetlife.com/*"
    ],
    "grant": [
      "GM_getValue",
      "GM_setValue",
      "GM_registerMenuCommand",
      "GM_addStyle"
    ],
    "run-at": "document-idle",
    "license": "MIT"
  },
  "files": [
    "../shared/ns.js",
    "../shared/storage.js",
    "../shared/flags.js",
    "../shared/observer.js",
    "../shared/spa.js",
    "../shared/ui-panel.js",
    "features/story-filter-core.js",
    "features/story-filter.js",
    "features/mute.js",
    "features/newest-discussions.js",
    "features/home-feed.js",
    "features/login-redirect.js",
    "features/gender-filter.js",
    "features/auto-follow.js",
    "features/overlay.js",
    "boot.js"
  ]
}
