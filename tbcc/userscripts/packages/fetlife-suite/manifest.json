{
  "name": "fetlife-suite",
  "version": "1.8.8",
  "header": {
    "name": "TBCC FetLife Suite",
    "namespace": "https://github.com/tbcc/userscripts/fetlife",
    "description": "FetLife suite: masonry, story filter, mute, ASL filter, auto-follow, place kinksters nav, infinite scroll, FLConsole, thin context intel, TBCC overlay.",
    "match": [
      "https://fetlife.com/*",
      "https://www.fetlife.com/*"
    ],
    "grant": [
      "GM_getValue",
      "GM_setValue",
      "GM_registerMenuCommand",
      "GM_addStyle"
    ],
    "run-at": "document-idle",
    "license": "MIT"
  },
  "files": [
    "../shared/ns.js",
    "../shared/storage.js",
    "../shared/flags.js",
    "../shared/observer.js",
    "../shared/spa.js",
    "../shared/ui-panel.js",
    "features/story-filter-core.js",
    "features/story-filter.js",
    "features/mute.js",
    "features/newest-discussions.js",
    "features/home-feed.js",
    "features/place-nav.js",
    "features/login-redirect.js",
    "features/gender-filter.js",
    "features/auto-follow.js",
    "features/infinite-scroll.js",
    "features/social-proof.js",
    "data/privacy-presets.js",
    "data/genders.js",
    "features/privacy-console.js",
    "features/overlay-intel.js",
    "features/overlay.js",
    "boot.js"
  ],
  "community": {
    "version": "1.0.0",
    "omitFiles": ["features/social-proof.js", "features/overlay-intel.js"],
    "header": {
      "name": "FetLife Enhancer",
      "namespace": "https://sleazyfork.org/users/1618643-ianmxaof",
      "homepageURL": "https://telegram.me/aofsubscriptions_bot",
      "description": "FetLife browsing: masonry home feed, story filter, mute, ASL/gender filter, auto-follow, place kinksters nav, infinite scroll, privacy presets. Community build — no analytics.",
      "author": "AOF community fork",
      "match": [
        "https://fetlife.com/*",
        "https://www.fetlife.com/*"
      ],
      "grant": [
        "GM_getValue",
        "GM_setValue",
        "GM_registerMenuCommand",
        "GM_addStyle"
      ],
      "run-at": "document-idle",
      "license": "MIT"
    }
  }
}
