{
  "manifest_version": 3,
  "name": "TBCC Importer",
  "version": "1.40.35",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "windows",
    "tabs",
    "storage",
    "notifications",
    "scripting",
    "sidePanel",
    "downloads",
    "cookies",
    "clipboardWrite",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src 'self' http://127.0.0.1:5173 http://localhost:5173;"
  },
  "action": {
    "default_title": "TBCC Importer (click: gallery · right-click: open or dock)",
    "default_icon": {
      "16": "icons/transparent/icon16.png",
      "48": "icons/transparent/icon48.png",
      "128": "icons/transparent/icon128.png"
    }
  },
  "options_ui": {
    "page": "model-search-options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "gallery.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tbcc-module-gate.js", "tbcc-username-filter.js", "tbcc-clipboard-toast.js", "page-overlay.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://onlyfans.com/*", "*://*.onlyfans.com/*"],
      "js": ["of-api-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://onlyfans.com/*", "*://*.onlyfans.com/*"],
      "js": ["tbcc-module-gate.js", "of-harvest.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["x-api-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["tbcc-module-gate.js", "x-feed-download.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["tbcc-module-gate.js", "x-profile-looms-shared.js", "x-profile-harvest.js", "x-profile-overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://erome.com/*", "*://*.erome.com/*"],
      "js": ["tbcc-module-gate.js", "tbcc-suite-rail.js", "tbcc-abbrev-number.js", "tbcc-browse-intel-common.js", "erome-enhancer.js", "erome-transport-overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://motherless.com/*",
        "*://*.motherless.com/*",
        "*://motherless.xxx/*",
        "*://*.motherless.xxx/*"
      ],
      "js": ["tbcc-module-gate.js", "tbcc-suite-rail.js", "tbcc-browse-intel-common.js", "motherless-infinite-scroll.js", "motherless-enhancer.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://thisvid.com/*", "*://*.thisvid.com/*"],
      "js": ["tbcc-module-gate.js", "tbcc-suite-rail.js", "tbcc-abbrev-number.js", "tbcc-browse-intel-common.js", "thisvid-infinite-scroll.js", "thisvid-enhancer.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://fetlife.com/*", "*://www.fetlife.com/*"],
      "js": ["tbcc-module-gate.js", "tbcc-suite-rail.js", "tbcc-browse-intel-common.js", "fetlife-suite.bundle.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://perchance.org/*",
        "*://*.perchance.org/*",
        "*://image-generation.perchance.org/*"
      ],
      "js": ["tbcc-module-gate.js", "perchance-suite.bundle.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://stripchat.com/*",
        "*://*.stripchat.com/*",
        "*://chaturbate.com/*",
        "*://*.chaturbate.com/*",
        "*://onlyfans.com/*",
        "*://*.onlyfans.com/*",
        "*://fansly.com/*",
        "*://*.fansly.com/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://x.com/*",
        "*://twitter.com/*",
        "*://xhamsterlive.com/*",
        "*://*.xhamsterlive.com/*",
        "*://cambb.xxx/*",
        "*://*.cambb.xxx/*",
        "*://nudecams.xxx/*",
        "*://*.nudecams.xxx/*"
      ],
      "js": [
        "tbcc-module-gate.js",
        "username-search-history-shared.js",
        "username-search-overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["of-api-hook.js", "of-harvest.js"],
      "matches": ["*://onlyfans.com/*", "*://*.onlyfans.com/*"]
    },
    {
      "resources": ["x-profile-harvest.js", "x-profile-overlay.js"],
      "matches": ["*://x.com/*", "*://twitter.com/*"]
    },
    {
      "resources": ["username-search-history-shared.js", "username-search-overlay.js"],
      "matches": [
        "*://stripchat.com/*",
        "*://*.stripchat.com/*",
        "*://chaturbate.com/*",
        "*://*.chaturbate.com/*",
        "*://onlyfans.com/*",
        "*://*.onlyfans.com/*",
        "*://fansly.com/*",
        "*://*.fansly.com/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://x.com/*",
        "*://twitter.com/*",
        "*://xhamsterlive.com/*",
        "*://*.xhamsterlive.com/*",
        "*://cambb.xxx/*",
        "*://*.cambb.xxx/*",
        "*://nudecams.xxx/*",
        "*://*.nudecams.xxx/*"
      ]
    }
  ]
}
