{
  "version": 1,
  "hints": [
    {
      "label": "Cloudflare API token",
      "suggest_key": "TBCC_CF_API_TOKEN",
      "match_url": "cloudflare.com/profile/api-tokens",
      "match_title": "cloudflare"
    },
    {
      "label": "Cloudflare account ID",
      "suggest_key": "TBCC_R2_ACCOUNT_ID",
      "match_url": "dash.cloudflare.com",
      "pattern": "^[a-f0-9]{32}$"
    },
    {
      "label": "R2 public base URL",
      "suggest_key": "TBCC_R2_PUBLIC_BASE_URL",
      "pattern": "^https://pub-[a-z0-9]+\\.r2\\.dev/?$"
    },
    {
      "label": "R2 S3 API endpoint",
      "suggest_key": "TBCC_R2_S3_ENDPOINT",
      "pattern": "^https://[a-z0-9.-]+\\.r2\\.cloudflarestorage\\.com(/.*)?$",
      "match_url": "r2.cloudflarestorage.com"
    },
    {
      "label": "ImgBB API key",
      "suggest_key": "TBCC_IMGBB_API_KEY",
      "match_url": "api.imgbb.com",
      "match_title": "imgbb"
    },
    {
      "label": "Buffer API token",
      "suggest_key": "BUFFER_API_TOKEN",
      "match_title": "buffer",
      "match_url": "buffer.com"
    },
    {
      "label": "OpenRouter API key",
      "suggest_key": "OPENROUTER_API_KEY",
      "pattern": "^sk-or-",
      "match_url": "openrouter.ai"
    },
    {
      "label": "Replicate API token",
      "suggest_key": "REPLICATE_API_TOKEN",
      "match_url": "replicate.com",
      "pattern": "^r8_"
    },
    {
      "label": "Pixeldrain API key",
      "suggest_key": "TBCC_PIXELDRAIN_API_KEY",
      "match_title": "pixeldrain",
      "match_url": "pixeldrain.com"
    },
    {
      "label": "Tailscale auth key (ephemeral)",
      "suggest_key": "TBCC_TAILSCALE_AUTHKEY",
      "pattern": "^tskey-",
      "match_url": "login.tailscale.com",
      "match_title": "tailscale"
    },
    {
      "label": "GitHub / GHCR token",
      "suggest_key": "TBCC_GHCR_TOKEN",
      "pattern": "^(ghp_|gho_|github_pat_)",
      "match_url": "github.com/settings/tokens"
    },
    {
      "label": "Gemini API key",
      "suggest_key": "TBCC_GEMINI_API_KEY",
      "pattern": "^AIza",
      "match_url": "aistudio.google.com"
    }
  ]
}
