{
  "mcpServers": {
    "tbcc": {
      "command": "py",
      "args": ["-3.13", "REPLACE_WITH_REPO_PATH/tbcc/mcp-server/server.py"],
      "env": {
        "TBCC_API_URL": "http://127.0.0.1:8000"
      }
    },
    "tbcc-loot-media": {
      "command": "py",
      "args": ["-3.13", "REPLACE_WITH_REPO_PATH/tbcc/mcp-server/loot_media_server.py"],
      "env": {
        "TBCC_LOOT_TIER_CARD_DIR": "REPLACE_WITH_REPO_PATH/tbcc/backend/app/data/loot_tier_cards"
      }
    },
    "buffer": {
      "url": "https://mcp.buffer.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_BUFFER_API_TOKEN"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ]
    }
  }
}
