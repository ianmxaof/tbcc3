# Telegram API (my.telegram.org)
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash

# Admin bot (get your ID from @userinfobot)
ADMIN_TELEGRAM_ID=your_telegram_user_id

# Payment bot (create via @BotFather)
BOT_TOKEN=your_bot_token_from_botfather

# Payment / subscriptions bot username, no @ (e.g. aofsubscriptions_bot). Must match the bot that owns BOT_TOKEN — not the secretary FAQ bot.
# Required for scheduler “Stars checkout” buttons (t.me/<username>?start=…). The secretary bot also links here for /subscribe and /packs.
TBCC_PAYMENT_BOT_USERNAME=your_bot_username

# --- Windows Terminal size (tray Cold start / start.ps1 -WtTabs) ---
# Pixel size of the one tabbed WT window that holds TBCC-Backend, Celery, etc. (not the cold-start launcher).
# TBCC_WT_WINDOW_SIZE=820,460
# TBCC_WT_WINDOW_WIDTH=820
# TBCC_WT_WINDOW_HEIGHT=460
# Console buffer inside each tab (columns × rows): TBCC_CONSOLE_COLS=84  TBCC_CONSOLE_LINES=24
# CLI overrides: .\start.ps1 -CompactConsole (smaller) or -WideConsole (larger)

# --- Loot overseer (@aof_lootgod_bot) — run: python -m bots.loot_bot (tbcc/backend). Dashboard: Bots → Loot overseer. ---
# Leave token empty here if you store it only in the dashboard; then set TBCC_INTERNAL_API_KEY so the bot can call /loot-bot-settings/internal-runtime.
TBCC_LOOT_BOT_TOKEN=
TBCC_LOOT_BOT_USERNAME=aof_lootgod_bot
TBCC_LOOT_ROOM_INVITE_URL=https://t.me/+97f4Crv3G1RkMGU5
# Main AOF community group — @aof_lootgod_bot daily Loot Room promo (Dashboard → Bots → Loot overseer)
# TBCC_LOOT_AOF_GROUP_CHAT_ID=-1001234567890
# TBCC_LOOT_DAILY_PROMO_ENABLED=0
# TBCC_LOOT_DAILY_PROMO_HOUR_UTC=18
# Mirror each daily promo to Buffer → X (280 chars); needs TBCC_BUFFER_API_KEY + TBCC_BUFFER_CHANNEL_ID_PRIMARY
# TBCC_LOOT_BUFFER_MIRROR_ENABLED=0
# TBCC_LOOT_BUFFER_PUBLISH_NOW=1
# TBCC_LOOT_REFERRAL_ENABLED=1
# TBCC_LOOT_REFERRAL_BONUS_PULLS=1
# TBCC_LOOT_NARRATIVE_ENABLED=0

# --- Secretary / FAQ bot (separate BotFather bot; optional Telegram Business “Chatbots”) ---
# If Telegram says the bot "doesn't support Telegram Business yet": @BotFather → your bot → Bot Settings → Business Mode → on.
TBCC_SECRETARY_BOT_TOKEN=
# Username only, no @ — must match the bot that owns TBCC_SECRETARY_BOT_TOKEN (not TBCC_PAYMENT_BOT_USERNAME).
TBCC_SECRETARY_BOT_USERNAME=
# TBCC_SECRETARY_API_URL=http://localhost:8000

# --- Macro model search bot (python -m bots.macro_search_bot) — /macrosearch, /macroaddsource ---
TBCC_MACRO_SEARCH_BOT_TOKEN=
# Username only, no @ — extension deep links use t.me/<username>?start=ms_<handle>
TBCC_MACRO_SEARCH_BOT_USERNAME=
# Forum topic bridge — Erome/Bunkr Links (supergroup + message_thread_id from find_forum_thread_id.py)
# TBCC_MACRO_SEARCH_FORUM_CHAT_ID=-1003206350461
# TBCC_MACRO_SEARCH_FORUM_THREAD_ID=
# TBCC_MACRO_SEARCH_FORUM_POST_WELCOME=1
# Optional; defaults to TBCC_INTERNAL_API_KEY for internal API calls from the secretary process.
# TBCC_SECRETARY_INTERNAL_API_KEY=
# TBCC_SECRETARY_LLM_MODEL=gpt-4o-mini
# TBCC_SECRETARY_LLM_MAX_TOKENS=800
# Per-user rolling-minute cap for /start, /help, /subscribe, /shop hints, and LLM FAQ turns (default 12). Raise only if needed.
# TBCC_SECRETARY_RATE_LIMIT_PER_MIN=12
# TBCC_SECRETARY_SYSTEM_PROMPT=Short support persona + escalation rules (plain text).
# TBCC_SECRETARY_HISTORY_MAX_MESSAGES=12
# Business Chatbots: default is suggest-only (drafts DM'd to ADMIN_TELEGRAM_ID). Set to enable in-thread replies:
# TBCC_SECRETARY_AUTO_REPLY=0
# Optional override for who receives drafts (defaults to ADMIN_TELEGRAM_ID):
# TBCC_SECRETARY_SUGGEST_NOTIFY_CHAT_ID=
# Format Engine (FE-LLMv4): persistent emotional context + adaptive support formats (default on).
# TBCC_FORMAT_ENGINE_ENABLED=1
# TBCC_FORMAT_ENGINE_MESSAGE_RETENTION=80
# TBCC_FORMAT_ENGINE_LLM_HISTORY=8
# LLM emotion refine when interaction phase changes (requires OpenAI key):
# TBCC_FORMAT_ENGINE_LLM_REFINE=0
# FAQ RAG for secretary bot (keyword scoring; optional embeddings):
# TBCC_SECRETARY_RAG_ENABLED=1
# TBCC_SECRETARY_RAG_TOP_K=4
# TBCC_SECRETARY_RAG_EMBEDDINGS=0
# TBCC_SECRETARY_RAG_EMBEDDING_MODEL=text-embedding-3-small
# TBCC_SECRETARY_SYSTEM_PROMPT_EXTRA=
# Telethon channel view stats (GET /analytics/telegram-channel-stats?channel=@…):
# uses API_ID, API_HASH, TBCC_POSTER_TELEGRAM_SESSION (same as poster worker).

# --- Generic LLM Telegram bot (python -m bots.llm_chat_bot) — separate @BotFather token; persona via prompt env ---
# TBCC_LLM_CHAT_BOT_TOKEN=

# --- Album Composer bot (python -m bots.album_composer_bot) — lite extension: stage albums via DM, post to TBCC channels ---
# Create a dedicated bot via @BotFather. Restricted to ADMIN_TELEGRAM_ID.
# TBCC_ALBUM_COMPOSER_BOT_TOKEN=
# TBCC_ALBUM_COMPOSER_POOL_ID=1
# Groups: keep BotFather Group Privacy ON unless you need passive intake. If OFF, only ADMIN_TELEGRAM_ID
# can use the bot in groups; everyone else is ignored silently (no denial spam).
# ollama (default) or openai
# TBCC_LLM_CHAT_PROVIDER=ollama
# TBCC_LLM_CHAT_PROVIDER=openrouter
# TBCC_OLLAMA_BASE_URL=http://127.0.0.1:11434
# TBCC_OLLAMA_MODEL=llama3.2
# TBCC_LLM_CHAT_OPENAI_MODEL=gpt-4o-mini
# TBCC_LLM_CHAT_MAX_TOKENS=512
# TBCC_LLM_CHAT_TEMPERATURE=0.8
# TBCC_LLM_CHAT_SYSTEM_PROMPT=Operator-defined system instructions (plain text).
# TBCC_LLM_CHAT_RATE_LIMIT_PER_MIN=30
# TBCC_LLM_CHAT_HISTORY_MAX_MESSAGES=24

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./tbcc.db
# With Docker (tbcc/infra): docker compose up -d postgres redis
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tbcc

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Celery poster worker (scheduled posts / pool albums): Telethon session basename — file is {name}.session in cwd (usually tbcc/backend).
# Must already be logged in; workers do NOT prompt for phone (use the same account as admin or copy admin.session → admin_poster.session).
# Keep poster separate from dashboard/import admin.session to avoid SQLite "database is locked" during extension sends.
TBCC_POSTER_TELEGRAM_SESSION=admin_poster
# Dev: auto-seed poster session from admin.session when poster is not authorized (SQLite backup; run Celery cwd = tbcc/backend).
TBCC_POSTER_AUTO_COPY_ADMIN_SESSION=1
# Bulk imports (channel scan, Saved Messages index, Celery telegram queue) — separate from dashboard admin.session.
# Same Telegram account is fine (copy admin.session); avoids import lock storms blocking thumbnails.
TBCC_IMPORT_TELEGRAM_SESSION=admin_import
TBCC_IMPORT_AUTO_COPY_ADMIN_SESSION=1
# Pool imports (extension/dashboard Dest → library): store on disk only — no Saved Messages upload.
# Set 0 to restore legacy behavior (upload to Saved Messages, then index).
TBCC_POOL_IMPORT_LOCAL=1
# Dashboard thumbnails / light reads use admin.session; imports use admin_import.session (separate Redis lock).
# Keep Telethon connected between API requests when sessions are separate (default). Set 1 to disconnect after
# every Telegram I/O (needed if poster/import still share admin.session).
# TBCC_TELEGRAM_DISCONNECT_AFTER_IO=0
# API + Celery share each session file via Redis — tasks wait in line instead of "database is locked" errors.
# Requires REDIS_URL (same as Celery). Max seconds to wait for the lock (default 300).
# TBCC_TELEGRAM_LOCK_TIMEOUT_S=300
# TBCC_TELEGRAM_LOCK_POLL_S=0.35
# API Telegram I/O retries when session file is briefly locked (default 8 attempts, exponential backoff).
# TBCC_TELEGRAM_IO_MAX_ATTEMPTS=8
# Telethon session SQLite busy_timeout in ms (default 120000). WAL is enabled on connect.
# TBCC_TELEGRAM_SQLITE_BUSY_TIMEOUT_MS=120000
# After this many consecutive failed sends, a scheduled job is auto-paused (beat skips it). Set 0 to disable.
# TBCC_SCHED_POST_AUTO_PAUSE_STREAK=5
# Pool interval auto-post (Celery Beat → check_and_schedule). Requires TBCC-Beat + TBCC-Celery.
# TBCC_POOL_AUTO_POST=1
# Beat tick interval for schedule-posts (minutes, 1–59). Default 2.
# TBCC_BEAT_SCHEDULE_MINUTES=2

# Backend URL (for payment bot when not localhost)
# TBCC_API_URL=http://localhost:8000

# External payments (wallet / Cash App / crypto — admin marks paid in API)
# Shared secret: payment bot sends X-TBCC-Internal-Key on POST /external-payment-orders/
# Generate a long random string; set the same value for API + bot environments.
# TBCC_INTERNAL_API_KEY=
#
# Instant admin alerts (API process needs same .env as payment bot for Telegram):
# - DM to ADMIN_TELEGRAM_ID using BOT_TOKEN (or TBCC_SALES_NOTIFY_BOT_TOKEN if you split bots)
# - Optional JSON POST to TBCC_SALES_NOTIFY_WEBHOOK_URL (Discord/Zapier/custom) with keys event, …
# - Set TBCC_PAYMENT_NOTIFY=0 to disable Telegram + webhook for these hooks only
#
# Optional HTML template for instructions (placeholders: {reference_code} {plan_name} {price_stars})
# TBCC_EXTERNAL_PAY_TEMPLATE=<b>Pay</b> — memo: <code>{reference_code}</code> …

# --- Public URLs for Telegram (HTTPS, no trailing slash) ---
# After **Upload** in Bots → Shop products, the API builds: {TBCC_PROMO_PUBLIC_BASE_URL}/static/promo/...
# Set this to your tunnel or live API so Telegram can fetch images (localhost never works for the bot).
# TBCC_PROMO_PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
#
# Fallback if TBCC_PROMO_PUBLIC_BASE_URL is unset (same purpose, older name):
# TBCC_PUBLIC_BASE_URL=https://api.example.com

# Optional: override directory for uploaded promo images (default: tbcc/uploads/promo)
# TBCC_PROMO_DIR=C:/path/to/tbcc/uploads/promo

# Payment bot: hide low/test subscription prices from /shop + /subscribe (0 = off). Example: 101 hides 100 ⭐ SKUs.
# TBCC_BOT_MIN_SUBSCRIPTION_STARS=101
# Subscription plan grid: buttons per row in Stars + crypto keyboards (1–4, default 2).
# TBCC_SUBSCRIPTION_CATALOG_COLUMNS=2

# Bot runtime adapter for dashboard Process monitor controls:
# - local   = API spawns/stops `python -m bots.payment_bot` itself (dev default)
# - command = API executes your process-manager commands below (systemd/docker/supervisor/task scheduler)
# TBCC_BOT_RUNTIME_ADAPTER=local
#
# Required when TBCC_BOT_RUNTIME_ADAPTER=command:
# TBCC_PAYMENT_BOT_CMD_START=
# TBCC_PAYMENT_BOT_CMD_STOP=
# Optional:
# TBCC_PAYMENT_BOT_CMD_RESTART=
# TBCC_PAYMENT_BOT_CMD_RELOAD=
# TBCC_PAYMENT_BOT_CMD_STATUS=
# Note: these can also be set from Dashboard → Bots → Payment bot settings (DB overrides env).
# Docker examples:
# TBCC_PAYMENT_BOT_CMD_START=docker compose -f infra/docker-compose.yml --profile bot up -d payment_bot
# TBCC_PAYMENT_BOT_CMD_STOP=docker compose -f infra/docker-compose.yml stop payment_bot
# TBCC_PAYMENT_BOT_CMD_RESTART=docker compose -f infra/docker-compose.yml restart payment_bot
# TBCC_PAYMENT_BOT_CMD_STATUS=docker compose -f infra/docker-compose.yml ps payment_bot
# Loot overseer Docker-style hooks (optional; same TBCC_BOT_RUNTIME_ADAPTER unless overridden in dashboard → Loot overseer):
# TBCC_LOOT_BOT_CMD_START=docker compose -f infra/docker-compose.yml --profile bot up -d loot_bot
# TBCC_LOOT_BOT_CMD_STOP=docker compose -f infra/docker-compose.yml stop loot_bot
# TBCC_LOOT_BOT_CMD_RESTART=docker compose -f infra/docker-compose.yml restart loot_bot
# TBCC_LOOT_BOT_CMD_RELOAD=
# TBCC_LOOT_BOT_CMD_STATUS=docker compose -f infra/docker-compose.yml ps loot_bot

# Payment bot /shop promo (optional — HTTPS image URLs; override hero copy)
# SHOP_HERO_IMAGE_URL=https://example.com/hero.jpg
# SHOP_HERO_CAPTION=Your markdown caption...
# SHOP_SUBSCRIPTION_IMAGE_URL=
# SHOP_PACKS_IMAGE_URL=
# SHOP_SUBSCRIPTION_CAPTION=
# SHOP_PACKS_CAPTION=

# Optional: absolute path where bundle .zip files are stored (backend + payment bot must match)
# TBCC_BUNDLE_DIR=C:/path/to/tbcc/uploads/bundles

# Global files injected into every TBCC zip (gallery ZIP, digital-pack upload, loot modifier zip)
# Dashboard: Misc → ZIP promo inserts (overrides env when saved there)
# TBCC_ZIP_PROMO_ENABLED=1
# TBCC_ZIP_PROMO_TEXT=Your links and contact info (plain text; also editable in dashboard)
# TBCC_ZIP_PROMO_DIR=C:/path/to/tbcc/uploads/zip_promo

# Referral (for /referral command)
# REFERRAL_GROUP_INVITE_LINK=https://t.me/joinchat/xxx
# REFERRAL_GROUP_NAME=Our Community
# REFERRAL_REWARD_DAYS=7
# REFERRAL_MODE=community (no premium yet) | premium (subscription rewards)

# --- Growth: milestone “progress” line in group (optional; sent after each new subscription) ---
# Telegram chat id (often negative), e.g. -1001234567890 — bot must be able to post here.
# MILESTONE_PROGRESS_CHAT_ID=

# --- TBCC MCP server (Cursor / Claude) — tbcc/mcp-server/README.md ---
# TBCC_API_URL=http://127.0.0.1:8000
# Optional header if you add auth to dashboard routes later:
# TBCC_MCP_INTERNAL_KEY=same-as-TBCC_INTERNAL_API_KEY

# --- Buffer (GraphQL API) — https://developers.buffer.com/guides/getting-started.html ---
# Key: https://publish.buffer.com/settings/api — same Bearer as Cursor MCP ~/.cursor/mcp.json if you use Buffer MCP.
TBCC_BUFFER_API_KEY=
TBCC_BUFFER_ORGANIZATION_ID=
# Primary connection (usually X): GetChannels → "id" where service is "twitter".
TBCC_BUFFER_CHANNEL_ID_PRIMARY=
# Multi-platform: Instagram id, comma, Threads id from GetChannels (service "instagram" then "threads") — no spaces.
# Together with TBCC_BUFFER_CHANNEL_ID_PRIMARY you have all three platforms.
TBCC_BUFFER_CHANNEL_IDS=
# Set 1 to queue only TBCC_BUFFER_CHANNEL_ID_PRIMARY (usually X) — recommended while testing X.
# TBCC_BUFFER_X_ONLY=1
# When mirroring to X, cap at 280 chars and append overflow CTA if longer (caption start + invite link).
# TBCC_BUFFER_X_OVERFLOW_URL=https://t.me/+hMQzGsBFjF02MDkx
# TBCC_BUFFER_X_OVERFLOW_LABEL=AOF
# TBCC_BUFFER_X_OVERFLOW_SUFFIX= read the rest at {label}: {url}
# TBCC_BUFFER_X_MAX_CHARS=280

# LLM caption rewrite for scheduled posts (per-job opt-in in Scheduler)
# TBCC_CAPTION_LLM_REWRITE_ENABLED=1
# TBCC_CAPTION_LLM_REWRITE_MODEL=gpt-4o-mini
# TBCC_CAPTION_LLM_REWRITE_RANDOM_PROB=0.25
# TBCC_CAPTION_LLM_REWRITE_MAX_TOKENS=1200
# Default scheduled mirrors to Buffer shareNow (immediate X) instead of addToQueue. Per-job checkbox overrides.
# TBCC_BUFFER_SCHEDULED_SHARE_NOW=1
# Optional: cap how many Buffer channels receive each mirror (default 6). Listening relay uses TBCC_BUFFER_RELAY_MAX_CHANNELS same way.
# TBCC_BUFFER_MIRROR_MAX_CHANNELS=3
# TBCC_BUFFER_RELAY_MAX_CHANNELS=3
# Optional GraphQL URL (default https://api.buffer.com)
# TBCC_BUFFER_GRAPHQL_URL=https://api.buffer.com

# --- Discord: channel webhook URL (https://discord.com/api/webhooks/...) — not a discord.gg invite ---
TBCC_DISCORD_LISTENING_RELAY_WEBHOOK_URL=

# --- Daily AOF landing bulletin (Celery Beat, UTC hour) — referrals + milestone copy ---
# TBCC_LANDING_BULLETIN_CHAT_ID=-100xxxxxxxxxx
# Optional forum topic id if the “landing” lives in a topic:
# TBCC_LANDING_BULLETIN_MESSAGE_THREAD_ID=12345
# TBCC_LANDING_BULLETIN_HOUR_UTC=14
# TBCC_LANDING_BULLETIN_BOT_USERNAME=YourBotName
# Optional: full intro (multiline). If unset, a default AOF blurb is used.
# TBCC_LANDING_BULLETIN_INTRO=🔥 Welcome...\n\nLine two...

# --- OpenRouter (https://openrouter.ai/keys) — OpenAI-compatible chat API ---
# One key powers secretary, caption rewrite, format engine, LLM chat bot, and optional vision gap-fill.
# Model catalog: https://openrouter.ai/models (e.g. free Venice Dolphin below).
# TBCC_LLM_PROVIDER=openrouter
# TBCC_OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_API_KEY=                    # alternate env name
# TBCC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TBCC_OPENROUTER_REFERER=https://tbcc.local
# TBCC_OPENROUTER_TITLE=TBCC
# Default text model when TBCC_LLM_MODEL unset:
# TBCC_OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
# TBCC_LLM_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
# Per-feature overrides still work, e.g. TBCC_SECRETARY_LLM_MODEL=..., TBCC_CAPTION_LLM_REWRITE_MODEL=...
# LLM Telegram bridge only: TBCC_LLM_CHAT_PROVIDER=openrouter

# --- LLM (Dashboard → shop AI, Media Library “AI suggest”) ---
# OpenAI (when TBCC_LLM_PROVIDER=openai): https://platform.openai.com/api-keys
# TBCC_OPENAI_API_KEY=
# OPENAI_API_KEY=
# TBCC_LLM_MODEL=gpt-4o-mini

# Vision auto-tag on import (Celery): Lustpress metadata + NSFW classifier + conservative LLM fallback.
# Requires Redis + Celery worker. LLM needs TBCC_OPENAI_API_KEY.
# API dev only: set to 1 to run uvicorn with --reload (can leave orphan workers on Windows; default is off).
# TBCC_UVICORN_RELOAD=0

# Fast import: POST /import/bytes returns job_id immediately; Celery telegram queue uploads to Saved Messages.
# TBCC_FAST_IMPORT=1
# TBCC_IMPORT_MAX_BYTES=524288000
# TBCC_IMPORT_TELEGRAM_TIMEOUT_S=600
# Use staged poster frame for NSFW classify (avoids re-download from Telegram). TBCC_CLASSIFY_USE_STAGED_BYTES=1
# Force synchronous import (legacy): TBCC_FAST_IMPORT=0 or form field sync=true
# TBCC_AUTO_TAG_ON_IMPORT=1

# Promo text watermark (Pillow images + ffmpeg video) on import/upload/send and gallery export via POST /import/watermark-bytes
# Dashboard: Media Library → Import from Saved → Promo watermark settings (GET/PATCH /watermark-settings)
# Album Composer bot: /watermark — per-draft text/opacity/color; burns in on send when apply_on_album_composer=1
# TBCC_WATERMARK_ENABLED=1
# TBCC_WATERMARK_TEXT=t.me/aofmainhub
# TBCC_WATERMARK_TEXT_SECONDARY=
# TBCC_WATERMARK_TEXT_TERTIARY=
# TBCC_WATERMARK_COLOR=#ffffff
# TBCC_WATERMARK_STRIP_PREVIOUS=0
# Set to 1 only when re-watermarking images that already have promo text burned in (blurs top/bottom edge bands first).
# TBCC_WATERMARK_MODE=rotate
# TBCC_WATERMARK_POSITION=bottom_right
# TBCC_WATERMARK_OPACITY=0.58
# TBCC_WATERMARK_SIZE_RATIO=0.024
# TBCC_WATERMARK_MARGIN_PX=10
# TBCC_WATERMARK_MAX_VIDEO_MB=250
# TBCC_WATERMARK_FONT_PATH=C:/Windows/Fonts/arial.ttf
# Per-request opt-out: form skip_watermark=true on POST /import/bytes, or gallery Options → Skip AOF promo watermark
# While bulk-approving in the dashboard, set to 0 to reduce Celery + Telegram contention (docs/TELEGRAM_OPS.md).
# TBCC_THUMBNAIL_FETCH_CONCURRENCY=2
# TBCC_THUMBNAIL_FETCH_TIMEOUT_S=45
# While bulk-approving in the dashboard, set to 0 to avoid Celery + Telegram thumbnail contention (see docs/TELEGRAM_OPS.md).
# TBCC_THUMBNAIL_FETCH_CONCURRENCY=2
# TBCC_THUMBNAIL_FETCH_TIMEOUT_S=45
# LLM only when tags/NSFW are ambiguous (default). Set TBCC_AUTO_TAG_LLM_ALWAYS=1 to always run vision.
# TBCC_AUTO_TAG_LLM_FALLBACK=1
# TBCC_AUTO_TAG_LLM_ALWAYS=0
# Optional max edge for downscaled image sent to OpenAI (default 1024)
# TBCC_AUTO_TAG_MAX_EDGE=1024

# Local NSFW classifier (TheHamkerCat/NSFW_Detection_API): GET ?url=…
# Run: docker-compose up -d in that repo, then point TBCC at it.
# TBCC_NSFW_DETECT_URL=http://127.0.0.1:8001
# TBCC_NSFW_DETECT_MIN_CONF=0.55
# Optional clone path (default: tbcc/services/NSFW_Detection_API) — start.ps1 -Full starts python -m api
# TBCC_NSFW_DETECT_DIR=C:/path/to/NSFW_Detection_API

# Lustpress metadata for video page URLs (self-hosted Bun/Elysia scraper)
# TBCC_LUSTPRESS_URL=http://127.0.0.1:3000
# Optional clone path (default: tbcc/services/lustpress) — start.ps1 -Full starts bun run start:dev
# TBCC_LUSTPRESS_DIR=C:/path/to/lustpress

# After vision auto-tag (or tag rule re-apply): assign media.pool_id from pools with route rules.
# Each pool may set comma-separated tag slugs (tbcc_tags.slug) and/or NSFW tiers (sfw,suggestive,explicit,unknown).
# If both are set on a pool, BOTH must match. Tier-only or slug-only rules are allowed. Lower route_priority wins.
# Only when pool_id is unset unless TBCC_AUTO_ROUTE_OVERWRITE=1.
# TBCC_AUTO_ROUTE_POOL=1
# TBCC_AUTO_ROUTE_OVERWRITE=0

# Local OpenAI-compatible API key (LM Studio, Ollama with auth, etc.) — for future use or custom tooling.
# TBCC_LOCAL_LLM_API_KEY=
# Optional base URL when the backend supports pointing chat completions at localhost (not wired yet).
# TBCC_LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1

# --- Automatic crypto (NOWPayments) + generic payment webhooks ---
# When all required vars are set, GET /health returns "crypto_auto_checkout": true and the payment bot shows
# Wallet/crypto users a hosted pay link; POST /webhooks/nowpayments fulfills orders (no dashboard mark-paid).
#
# 1) TBCC_PUBLIC_API_BASE_URL — public https:// base of THIS API (no trailing slash). NOWPayments must reach
#    {TBCC_PUBLIC_API_BASE_URL}/webhooks/nowpayments — use ngrok/Cloudflare Tunnel in dev (not localhost).
# 2) TBCC_NOWPAYMENTS_API_KEY — from NOWPayments dashboard.
# 3) TBCC_NOWPAYMENTS_IPN_SECRET — same as “IPN secret” in NOWPayments; must match what they send in X-NOWPAYMENTS-SIG.
# 4) In NOWPayments, set the IPN callback URL to: {TBCC_PUBLIC_API_BASE_URL}/webhooks/nowpayments
# 5) TBCC_INTERNAL_API_KEY — must match on payment bot so POST /external-payment-orders/ succeeds.
#
# TBCC_PUBLIC_API_BASE_URL=https://your-api.example.com
# TBCC_NOWPAYMENTS_API_KEY=
# TBCC_NOWPAYMENTS_IPN_SECRET=
# Optional: lock checkout to one currency/ticker (example: usdttrc20).
# Leave unset/empty to let NOWPayments hosted checkout offer broader supported currencies.
# TBCC_NOWPAYMENTS_PAY_CURRENCY=
# TBCC_STARS_USD_PER_STAR=0.012            # heuristic: Stars list price → USD for NP quote
# TBCC_NOWPAYMENTS_MIN_CHECKOUT_USD=15     # optional floor to avoid coin/network minimum failures on low-price items
# Optional: POST /webhooks/instant-payment with Authorization: Bearer <secret> JSON {"reference_code":"EPO-…"}
# TBCC_PAYMENT_WEBHOOK_SECRET=
#
# --- My.JDownloader (optional — gallery Crawl tab fallback + Send to JDownloader) ---
# Create credentials at https://my.jdownloader.org/ (App password recommended).
# JDownloader desktop must be running with My.JDownloader remote access enabled.
# TBCC_MYJD_EMAIL=
# TBCC_MYJD_PASSWORD=
# TBCC_MYJD_DEVICE_NAME=              # optional; first linked device if empty
# TBCC_MYJD_ENABLED=1
# TBCC_MYJD_POLL_TIMEOUT_S=120        # max wait for linkgrabber crawl
# TBCC_MYJD_REQUEST_TIMEOUT_S=45       # hard cap per MyJD API call (prevents hung backend)
# TBCC_MYJD_MAX_LINKS_PER_BATCH=40     # chunk large gallery sends into smaller JD packages
# TBCC_MYJD_ASYNC=1                    # always queue add-links via Celery (recommended)
# TBCC_MYJD_ASYNC_MIN_LINKS=12         # auto-queue when payload has this many URLs or more
# TBCC_CRAWLER_MYJD_MODE=auto           # auto | always | never — when to use JD after local crawl
# Point JD default download folder at TBCC_WATCH_INBOX (see below) for hands-free ingest.
#
# --- Download inbox organizer (watch-folder auto categorization) ---
# Point downloader output to TBCC_WATCH_INBOX, then run:
#   cd tbcc/backend && python -m app.services.watch_folder_organizer
# One-shot:
#   cd tbcc/backend && python -m app.services.watch_folder_organizer --once
# Dry-run:
#   cd tbcc/backend && python -m app.services.watch_folder_organizer --once --dry-run
# TBCC_WATCH_INBOX=C:/Users/you/Downloads/tbcc/inbox
# TBCC_WATCH_LIBRARY=C:/Users/you/Downloads/tbcc_library
# TBCC_WATCH_DEBOUNCE_S=1.5
# Wait before moving and verify size/mtime stability (prevents moving partial files).
# TBCC_WATCH_STABLE_WAIT_S=2.0
# Keep only Images/Videos in the watch pipeline (all other categories are treated as non-media).
# TBCC_WATCH_MEDIA_ONLY=1
# Optional destination for non-media when TBCC_WATCH_MEDIA_ONLY=1.
# If unset, non-media files are skipped and remain in inbox.
# TBCC_WATCH_REJECT_DIR=C:/Users/you/Downloads/tbcc_rejected
# Optional extension→category override map (comma-separated):
# ".cbz=Archives,.nfo=Documents,.jpeg=Images"
# Categories: Images, Videos, Audio, Archives, Documents, LinkLists, Playlists, Other
# TBCC_WATCH_CATEGORY_OVERRIDES=.cbz=Archives,.nfo=Documents
# TBCC_WATCH_LOG=C:/Users/you/Downloads/tbcc_watch_log.jsonl
# NSFW image subfolders under Images/ (requires TBCC API + TBCC_NSFW_DETECT_URL sidecar running):
# TBCC_WATCH_NSFW_TIER_SUBFOLDERS=1
# TBCC_WATCH_NSFW_CLASS_SUBFOLDERS=1
# Optional vision LLM sidecars (*.tbcc-meta.json) with niche/act/body_type facets (OpenAI cost per file):
# TBCC_WATCH_LLM_TAG=1

# --- Local CLIP niche categorizer (OpenCLIP ViT-B/32, port 8002) ---
# Fixed category list: image embedding vs precomputed text embeddings (zero-shot, no LLM vision).
# Point at your ~1400-category JSON/txt; first run encodes prompts (~few min CPU, cached as .clip_embeddings.npz).
# Optional Hugging Face token for faster model downloads / higher rate limits (read-only is enough):
# HF_TOKEN=hf_xxxxxxxx
# TBCC_CLIP_CATEGORIZE_URL=http://127.0.0.1:8002
# TBCC_CLIP_CATEGORIES_FILE=C:/path/to/your/categories.json
# TBCC_CLIP_MIN_CONF=0.08
# TBCC_CLIP_MIN_MARGIN=0.02
# TBCC_CLIP_PROMPT_TEMPLATE=a photo of {label}
# Third-level niche folders under Images/{tier}/{class}/ (default on when CLIP URL is set):
# TBCC_WATCH_CLIP_NICHE_SUBFOLDERS=1

# --- Vision LLM gap-fill (only when CLIP confidence is low) ---
# Providers: none | openai | openrouter | ollama
# TBCC_VISION_LLM_PROVIDER=openrouter
# TBCC_VISION_LLM_ON_LOW_CLIP=1
# TBCC_OPENROUTER_API_KEY=
# TBCC_OPENROUTER_VISION_MODEL=google/gemma-3-12b-it:free
# TBCC_OLLAMA_BASE_URL=http://127.0.0.1:11434
# TBCC_OLLAMA_VISION_MODEL=llava
# TBCC_VISION_LLM_MODEL=   # override model for any provider

# --- Focus profiles (stop optional services without full stack shutdown) ---
# API: GET/POST http://127.0.0.1:8000/ops/focus — dashboard banner + tray supervisor
# TBCC_FOCUS_AUTO_REACT=1          # auto-apply telegram_relief on session lock storm
# TBCC_FOCUS_AUTO_IMPORT=1         # auto import_burst on fast import + queue spike
# TBCC_FOCUS_IMPORT_JOBS_THRESHOLD=2
# TBCC_FOCUS_IMPORT_IDLE_RESTORE_MIN=15
# TBCC_FOCUS_LOCK_EVENTS_THRESHOLD=3
# TBCC_FOCUS_LOCK_WINDOW_S=120
# TBCC_FOCUS_IDLE_RESTORE_MIN=20   # auto-restore telegram_relief after calm period

# --- Ops alerts (toast / tray / extension notifications) ---
# TBCC_ALERTS_ENABLED=1
# TBCC_ALERTS_HUB_SCAN=1           # tail .tbcc-run/error-hub.log for irregular lines
# TBCC_ALERTS_DEDUP_TTL_S=1800     # suppress repeat of same alert for 30m
# TBCC_ALERTS_HUB_FROM_START=0     # 1 = scan full log on first poll (not recommended)

# --- Link resolver (Bypass.vip / compatible API) + /resolve in payment bot ---
# Requires: Redis, Celery worker with queues link + link_priority (see infra/docker-compose worker_link),
# TBCC_INTERNAL_API_KEY on bot + API, and a premium API key from the provider.
# Docs pointer: https://api.bypass.vip/
#
# TBCC_BYPASS_API_KEY=
# Set 0 to disable accepting new jobs (API returns 503 on POST /link-resolver/requests).
# TBCC_BYPASS_ENABLED=1
# TBCC_BYPASS_API_BASE_URL=https://api.bypass.vip
# TBCC_BYPASS_API_PATH=/v1
# TBCC_BYPASS_HTTP_METHOD=GET
# TBCC_BYPASS_TIMEOUT_S=45
# Query param names if your plan uses different ones:
# TBCC_BYPASS_URL_QUERY_PARAM=url
# TBCC_BYPASS_KEY_QUERY_PARAM=key
# Global sliding window (protect provider rate limits; default ~8 per 10s):
# TBCC_BYPASS_GLOBAL_MAX_PER_WINDOW=8
# TBCC_BYPASS_GLOBAL_WINDOW_SEC=10
# Per-user hourly quotas (free vs premium tier from active subscriptions):
# TBCC_LINK_RESOLVER_FREE_PER_HOUR=15
# TBCC_LINK_RESOLVER_PREMIUM_PER_HOUR=120
# Payment bot poll timeout for /resolve (seconds):
# TBCC_LINK_RESOLVER_POLL_MAX_S=120

# --- Promo affiliate links (Misc picker): optional HTTP shortening ------------------------------
# Fill short_url via POST /promo-affiliate-links/{id}/shorten from the dashboard picker.
# isgd — free is.gd (subject to their limits); tinyurl — https://tinyurl.com/app/dev API token
# TBCC_PROMO_SHORTEN_PROVIDER=isgd
# TBCC_PROMO_SHORTEN_PROVIDER=tinyurl
# TBCC_TINYURL_API_TOKEN=
# Pixeldrain (ShareX-style): uploads the long URL as a small .txt via PUT /api/file/{name}; viewer URL is /u/{id}
# TBCC_PROMO_SHORTEN_PROVIDER=pixeldrain
# TBCC_PIXELDRAIN_API_KEY=
# Optional mirror (default https://pixeldrain.com/api):
# TBCC_PIXELDRAIN_API_BASE=https://pixeldrain.com/api

# --- Gravatar (profile cards / REST API) ---------------------------------------------------------
# Bearer token from https://gravatar.com/developers — server-side only (never in extension/dashboard bundle).
# oEmbed: GET https://api.gravatar.com/v3/oembed?url=https://gravatar.com/{username}
# Docs: https://docs.gravatar.com/embedding-profile-card/
# TBCC_GRAVATAR_API_KEY=
# Optional default profile for embeds (username only, no @):
# TBCC_GRAVATAR_PROFILE_USERNAME=
