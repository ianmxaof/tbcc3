# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./tbcc.db
# With Docker (tbcc/infra): docker compose up -d postgres redis
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tbcc

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Celery poster worker (scheduled posts / pool albums): Telethon session basename — file is {name}.session in cwd (usually tbcc/backend).
# Must already be logged in; workers do NOT prompt for phone (use the same account as admin or copy admin.session → admin_poster.session).
# Keep poster separate from dashboard/import admin.session to avoid SQLite "database is locked" during extension sends.
TBCC_POSTER_TELEGRAM_SESSION=admin_poster
# Dev: auto-seed poster session from admin.session when poster is not authorized (SQLite backup; run Celery cwd = tbcc/backend).
TBCC_POSTER_AUTO_COPY_ADMIN_SESSION=1
# Bulk imports (channel scan, Saved Messages index, Celery telegram queue) — separate from dashboard admin.session.
# Same Telegram account is fine (copy admin.session); avoids import lock storms blocking thumbnails.
TBCC_IMPORT_TELEGRAM_SESSION=admin_import
TBCC_IMPORT_AUTO_COPY_ADMIN_SESSION=1
# Pool imports (extension/dashboard Dest → library): store on disk only — no Saved Messages upload.
# Set 0 to restore legacy behavior (upload to Saved Messages, then index).
TBCC_POOL_IMPORT_LOCAL=1
# Channel scraper: forward-only to Saved Messages (default 1). No download_media fallback (no RAM/local disk pull).
TBCC_SCRAPER_FORWARD_ONLY=1
# Auto-skip entire source when channel forbids forwarding (default 1). Deactivates source + records channel intel.
TBCC_SCRAPER_SKIP_NOFORWARD=1
# Remote scrape worker (GCP e2-micro / Oracle / Hetzner): home Celery must NOT consume `scrape`.
# TBCC_CELERY_HOME_QUEUES=celery,subscription,telegram
# See tbcc/docs/REMOTE_WORKER.md
# TBCC_HOME_TAILSCALE_IP=100.x.y.z          # auto-filled by enable-home-offload.ps1
# TBCC_TAILSCALE_AUTHKEY=tskey-auth-...    # ephemeral; used by create-gcp-vm.ps1 startup
# TBCC_GHCR_USER=ianmxaof
# TBCC_GHCR_TOKEN=ghp_...                  # read:packages (VM) / write:packages (push)
# TBCC_USE_GHCR=1
# TBCC_WORKER_IMAGE=ghcr.io/ianmxaof/tbcc-worker:latest
# TBCC_GHCR_PUSH_ON_LAUNCH=0          # set 1 to docker push on every start.ps1
# TBCC_REMOTE_WORKER_LOG_TICK_S=5     # WT tab poll interval for VM logs
# TBCC_GCP_PROJECT=tbcc-cloud-instance
# TBCC_GCP_ZONE=us-west1-a
# TBCC_GCP_INSTANCE=tbcc-remote-worker

# Ops lanes (Phase 4): heavy Beat ticks (flywheel, income_poll, market_intel, storage_pool_seed,
# listening_relay, erome_analytics) route to ops_* queues consumed by TBCC-Celery-Ops so they never
# serialize behind run_schedule on the solo home worker. Enable TBCC-Celery-Ops in the tray Services menu.
# TBCC_CELERY_OPS_QUEUES=ops_growth,ops_relay,ops_erome
# Fallback if you do NOT run TBCC-Celery-Ops: append its queues to the home worker or those tasks strand:
# TBCC_CELERY_HOME_QUEUES=celery,scrape,subscription,telegram,ops_growth,ops_relay,ops_erome
# Dashboard thumbnails / light reads use admin.session; imports use admin_import.session (separate Redis lock).
# Keep Telethon connected between API requests when sessions are separate (default). Set 1 to disconnect after
# every Telegram I/O (needed if poster/import still share admin.session).
# TBCC_TELEGRAM_DISCONNECT_AFTER_IO=0
# API + Celery share each session file via Redis — tasks wait in line instead of "database is locked" errors.
# Requires REDIS_URL (same as Celery). Max seconds to wait for the lock (default 300).
# TBCC_TELEGRAM_LOCK_TIMEOUT_S=300
# TBCC_TELEGRAM_LOCK_POLL_S=0.35
# API Telegram I/O retries when session file is briefly locked (default 8 attempts, exponential backoff).
# TBCC_TELEGRAM_IO_MAX_ATTEMPTS=8
# Telethon session SQLite busy_timeout in ms (default 120000). WAL is enabled on connect.
# TBCC_TELEGRAM_SQLITE_BUSY_TIMEOUT_MS=120000
# After this many consecutive failed sends, a scheduled job is auto-paused (beat skips it). Set 0 to disable.
# TBCC_SCHED_POST_AUTO_PAUSE_STREAK=5
# Pool interval auto-post (Celery Beat → check_and_schedule). Requires TBCC-Beat + TBCC-Celery.
# TBCC_POOL_AUTO_POST=1
# TBCC_POST_POOL_MAX_QUEUE_DEPTH=3   # skip pool auto-post when post queue deeper (scheduled posts win)
# TBCC_POST_QUEUE_BACKLOG_THRESHOLD=5   # health banner + auto-remediate resume when post queue this deep
# TBCC_SCHEDULER_STALL_MINUTES=15       # auto-resume when any scheduler this many minutes overdue
# TBCC_WATCHDOG_IMPORT_IDLE_MINUTES=3   # watchdog restores import_burst focus after imports idle this long
# TBCC_WATCHDOG_FORCE_RESTART_STREAK=2  # consecutive overdue ticks (post queue empty, workers up) before the watchdog stops re-enqueuing and defers to per-row auto-pause (send-failure circuit breaker; no stack restart)
# TBCC_WATCHDOG_DRAIN_EMPTY_OVERDUE_MIN=2   # minutes an empty post queue may stay overdue before the watchdog migrates stale scheduler tasks
# TBCC_POOL_AUTOPOST_PAUSE_WHEN_OVERDUE=1   # skip all pool auto-post while any scheduler is overdue
# TBCC_THUMBNAIL_WARM_PAUSE_WHEN_POST_STALLED=1   # defer thumbnail warm when scheduler lane stalled
# Beat tick interval for schedule-posts (minutes, 1–59). Default 2; 5 reduces CPU on always-on stacks.
# TBCC_BEAT_SCHEDULE_MINUTES=5
# Beat tick batches due scheduled posts into one Celery-Post drain job (single admin_poster lock).
# TBCC_POST_BATCH_ENQUEUE=1
# TBCC_POST_DRAIN_TICK_S=600
# TBCC_POST_ENQUEUE_DEDUPE_S=180          # min Redis lock while a send is pending
# TBCC_POST_ENQUEUE_DEDUPE_MAX_S=900      # hard cap (default 15m) — prevents multi-hour orphan lock stalls
# TBCC_POSTER_DRAIN_LOCK_TIMEOUT_S=180    # wait for Telethon account lock before drain times out (was 45)
# Beat tick batches due scheduled posts into one Celery-Post drain job (single admin_poster session lock).
# TBCC_POST_BATCH_ENQUEUE=1
# TBCC_POST_DRAIN_TICK_S=600

# Remote worker mesh (Tailscale IP of the scrape VM). start.ps1 [0b] brings Tailscale up.
# Prefer: .\scripts\remote-worker\enable-home-offload.ps1 -RemoteHost 100.x.y.z
# TBCC_REMOTE_STACK_HOST=100.x.y.z
# TBCC_REMOTE_STACK_USER=ubuntu
# TBCC_REMOTE_STACK_PATH=/opt/tbcc


# Backend URL (for payment bot when not localhost)
# TBCC_API_URL=http://localhost:8000

# External payments (wallet / Cash App / crypto — admin marks paid in API)
# Shared secret: payment bot sends X-TBCC-Internal-Key on POST /external-payment-orders/
# Generate a long random string; set the same value for API + bot environments.
# TBCC_INTERNAL_API_KEY=
#
# Instant admin alerts (API process needs same .env as secretary bot for Telegram inbox DMs):
# - Routed through admin_inbox → TBCC_SECRETARY_BOT_TOKEN (see secretary section above)
# - Completed sales: instant when TBCC_INBOX_INSTANT_SALES=1 (default); loot keys / subs / packs all use same path
# - Ops errors: instant per TBCC_INBOX_INSTANT (default critical only)
# - Secretary *process* not required for sale/error DMs — only for /inbox digests and Approve/Deny callbacks
# - Optional JSON POST to TBCC_SALES_NOTIFY_WEBHOOK_URL (Discord/Zapier/custom) with keys event, …
# - Set TBCC_PAYMENT_NOTIFY=0 to disable payment/invoice inbox events + webhook hooks
#
# Optional HTML template for instructions (placeholders: {reference_code} {plan_name} {price_stars})
# TBCC_EXTERNAL_PAY_TEMPLATE=<b>Pay</b> — memo: <code>{reference_code}</code> …

# --- Public URLs for Telegram (HTTPS, no trailing slash) ---
# After **Upload** in Bots → Shop products, the API builds: {TBCC_PROMO_PUBLIC_BASE_URL}/static/promo/...
# Set this to your tunnel or live API so Telegram can fetch images (localhost never works for the bot).
# TBCC_PROMO_PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
#
# Fallback if TBCC_PROMO_PUBLIC_BASE_URL is unset (same purpose, older name):
# TBCC_PUBLIC_BASE_URL=https://api.example.com

# Optional: override directory for uploaded promo images (default: tbcc/uploads/promo)
# TBCC_PROMO_DIR=C:/path/to/tbcc/uploads/promo

# Payment bot: hide low/test subscription prices from /shop + /subscribe (0 = off). Example: 101 hides 100 ⭐ SKUs.
# TBCC_BOT_MIN_SUBSCRIPTION_STARS=101
# Subscription plan grid: buttons per row in Stars + crypto keyboards (1–4, default 2).
# TBCC_SUBSCRIPTION_CATALOG_COLUMNS=2

# Bot runtime adapter for dashboard Process monitor controls:
# - command = tray supervisor (default on Windows) — RECOMMENDED
# - local   = API spawns python -m bots.* itself (dev only; causes 409 if tray is also running)
# TBCC_BOT_RUNTIME_ADAPTER=command
#
# Optional explicit hooks (auto-filled from tbcc-stack-cli.ps1 when unset):
# TBCC_PAYMENT_BOT_CMD_START=
# TBCC_PAYMENT_BOT_CMD_STOP=
# TBCC_PAYMENT_BOT_CMD_RESTART=
# TBCC_PAYMENT_BOT_CMD_STATUS=
# Note: these can also be set from Dashboard → Bots → Payment bot settings (DB overrides env).
# Docker examples:
# TBCC_PAYMENT_BOT_CMD_START=docker compose -f infra/docker-compose.yml --profile bot up -d payment_bot
# TBCC_PAYMENT_BOT_CMD_STOP=docker compose -f infra/docker-compose.yml stop payment_bot
# TBCC_PAYMENT_BOT_CMD_RESTART=docker compose -f infra/docker-compose.yml restart payment_bot
# TBCC_PAYMENT_BOT_CMD_STATUS=docker compose -f infra/docker-compose.yml ps payment_bot
# Loot overseer Docker-style hooks (optional; same TBCC_BOT_RUNTIME_ADAPTER unless overridden in dashboard → Loot overseer):
# TBCC_LOOT_BOT_CMD_START=docker compose -f infra/docker-compose.yml --profile bot up -d loot_bot
# TBCC_LOOT_BOT_CMD_STOP=docker compose -f infra/docker-compose.yml stop loot_bot
# TBCC_LOOT_BOT_CMD_RESTART=docker compose -f infra/docker-compose.yml restart loot_bot
# TBCC_LOOT_BOT_CMD_RELOAD=
# TBCC_LOOT_BOT_CMD_STATUS=docker compose -f infra/docker-compose.yml ps loot_bot

# Payment bot /shop promo (optional — HTTPS image URLs; override hero copy)
# SHOP_HERO_IMAGE_URL=https://example.com/hero.jpg
# SHOP_HERO_CAPTION=Your markdown caption...
# SHOP_SUBSCRIPTION_IMAGE_URL=
# SHOP_PACKS_IMAGE_URL=
# SHOP_SUBSCRIPTION_CAPTION=
# SHOP_PACKS_CAPTION=

# Optional: absolute path where bundle .zip files are stored (backend + payment bot must match)
# TBCC_BUNDLE_DIR=C:/path/to/tbcc/uploads/bundles

# Global files injected into every TBCC zip (gallery ZIP, digital-pack upload, loot modifier zip)
# Dashboard: Misc → ZIP promo inserts (overrides env when saved there)
# TBCC_ZIP_PROMO_ENABLED=1
# TBCC_ZIP_PROMO_TEXT=Your links and contact info (plain text; also editable in dashboard)
# TBCC_ZIP_PROMO_DIR=C:/path/to/tbcc/uploads/zip_promo

# Referral (for /referral command)
# REFERRAL_GROUP_INVITE_LINK=https://t.me/joinchat/xxx
# REFERRAL_GROUP_NAME=Our Community
# REFERRAL_REWARD_DAYS=7
# REFERRAL_MODE=community (no premium yet) | premium (subscription rewards)

# --- Growth: milestone “progress” line in group (optional; sent after each new subscription) ---
# Telegram chat id (often negative), e.g. -1001234567890 — bot must be able to post here.
# MILESTONE_PROGRESS_CHAT_ID=
# TBCC_MILESTONE_DISPLAY_BOOST=52   # FOMO line only (e.g. 0 real → shows 52/100); triggers use real count

# --- TBCC MCP server (Cursor / Claude) — tbcc/mcp-server/README.md ---
# TBCC_API_URL=http://127.0.0.1:8000
# Optional header if you add auth to dashboard routes later:
# TBCC_MCP_INTERNAL_KEY=same-as-TBCC_INTERNAL_API_KEY

# --- Buffer (GraphQL API) — https://developers.buffer.com/guides/getting-started.html ---
# Keep all TBCC_BUFFER_* vars in this block only (duplicate keys in .env break channel ids).
# Key: https://publish.buffer.com/settings/api — same Bearer as Cursor MCP ~/.cursor/mcp.json if you use Buffer MCP.
TBCC_BUFFER_API_KEY=
TBCC_BUFFER_ORGANIZATION_ID=
# Primary connection (usually X): GetChannels → "id" where service is "twitter".
TBCC_BUFFER_CHANNEL_ID_PRIMARY=
# Second X profile for AOF VIP lane (e.g. PowerCoreAi). Loot Room / default stays PRIMARY.
# TBCC_BUFFER_CHANNEL_ID_X_SECONDARY=
# Optional explicit map Telegram-channel-id → Buffer channel id (overrides VIP default):
# TBCC_BUFFER_X_BY_TG_CHANNEL=-1003982098745:6a4a5db3404834462871438c
# Multi-platform: Instagram id, comma, Threads id from GetChannels (service "instagram" then "threads") — no spaces.
# Together with TBCC_BUFFER_CHANNEL_ID_PRIMARY you have all three platforms.
TBCC_BUFFER_CHANNEL_IDS=
# Set 1 to queue only TBCC_BUFFER_CHANNEL_ID_PRIMARY (usually X) — recommended while testing X.
# TBCC_BUFFER_X_ONLY=0
# TBCC_BUFFER_ARMORY_MIN_DEPTH=3   # auto-refill relay + scheduled buffer_x_queue when below this (beat every 6h)
# TBCC_BUFFER_NATIVE_MIN_DEPTH=3   # auto-refill Buffer native X queue when scheduled count below this
# TBCC_BUFFER_NATIVE_MAX_SCHEDULED=10   # plan cap (Buffer org limits.scheduledPosts)
# Automated build-in-public (scripts/run_ship_log_tick.py + register-ship-log-scheduled-task.ps1)
# TBCC_SHIP_LOG_AUTO_MODE=idea   # idea (default) | queue (milestone → X addToQueue) | share_now
# TBCC_SHIP_LOG_MILESTONE_COMMITS=5   # commits in window → milestone draft
# TBCC_X_USE_LINKVERTISE=0   # 0 = Linkvertise on Telegram only; Buffer/X uses hub + affiliates
# X link preview: affiliate URL always first when present (default ON — avoids Telegram globe cards)
# TBCC_BUFFER_X_AFFILIATE_FIRST=1
# When AFFILIATE_FIRST=0, rotate first URL among affiliate / hub / erome / telegram
# TBCC_BUFFER_X_LINK_CYCLE=1
# SFW promo images on X (Buffer embed needs direct https image URL — not the monetized viewer page)
# TBCC_BUFFER_X_PROMO_IMAGES=1
# TBCC_X_PROMO_IMAGE_POOL_FILE=backend/app/data/aof_x_promo_image_pool.json
# TBCC_X_PROMO_IMAGE_URLS=https://i.example.com/a.jpg,https://i.example.com/b.jpg
# Pool JSON entries: {"direct_url":"…jpg","viewer_url":"…"} — direct_url for tweet image, viewer_url optional in caption
# Upload pool: py scripts/upload_x_promo_pool.py --folder PATH --execute
# Cloudflare R2 (permanent promo bucket — enable Public Access on bucket, copy pub-….r2.dev URL)
# TBCC_CF_API_TOKEN=                    # profile API token: Account / Workers R2 Storage / Edit
# TBCC_R2_ACCOUNT_ID=                   # R2 overview sidebar (32-char hex)
# TBCC_R2_BUCKET=aof-media              # single bucket; prefixes below
# TBCC_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev   # or media.powercore / custom domain on aof-media
# TBCC_R2_S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com   # optional; upload script uses REST+token
# Object key prefixes (extension context menus → POST /import/watermark-upload-r2):
#   library/       — TBCC: Watermark → R2 aof-media (library)
#   sfw-x-promo/   — TBCC: Watermark → R2 SFW X promo (legacy x-promo/ maps here)
# ImgBB API (bootstrap uploads; omit expiration = permanent). Use data.url not url_viewer.
# TBCC_IMGBB_API_KEY=
