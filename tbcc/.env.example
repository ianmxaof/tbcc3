# Telegram API (my.telegram.org)
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash

# Admin bot (get your ID from @userinfobot)
ADMIN_TELEGRAM_ID=your_telegram_user_id
# Global TBCC/AOF operators (comma-separated). Hardcoded always: 7787282561, 8630278848, 8682971339.
# TBCC_OPERATOR_IDS=
# Comma-separated extra Telegram user ids with unlimited loot free pulls + full key rolls (QA).
# TBCC_LOOT_OPERATOR_IDS=

# Payment bot (create via @BotFather)
BOT_TOKEN=your_bot_token_from_botfather

# Payment / subscriptions bot username, no @ (e.g. aofsubscriptions_bot). Must match the bot that owns BOT_TOKEN — not the secretary FAQ bot.
# Required for scheduler “Stars checkout” buttons (t.me/<username>?start=…). The secretary bot also links here for /subscribe and /packs.
TBCC_PAYMENT_BOT_USERNAME=your_bot_username

