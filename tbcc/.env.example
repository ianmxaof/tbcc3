# TBCC_BUFFER_RELAY_MAX_CHANNELS=3
# Optional GraphQL URL (default https://api.buffer.com)
# TBCC_BUFFER_GRAPHQL_URL=https://api.buffer.com

# --- Reddit (PRAW) — rules-aware subreddit fan-out; dry-run by default ---
# https://www.reddit.com/prefs/apps → script app → TBCC_REDDIT_CLIENT_ID / SECRET
# TBCC_REDDIT_USERNAME= / TBCC_REDDIT_PASSWORD= (dedicated promo account, not personal)
# TBCC_REDDIT_USER_AGENT=TBCC:AOF:v1 (by /u/youruser)
# TBCC_REDDIT_ENABLED=0
# TBCC_REDDIT_EXECUTE=0          # 1 = live submit (keep 0 until subs vetted)
# TBCC_REDDIT_MIRROR_ON_SCHEDULED=1
# TBCC_REDDIT_FANOUT_LIMIT=1
# TBCC_REDDIT_GLOBAL_MAX_POSTS_PER_DAY=3
# TBCC_REDDIT_GLOBAL_MIN_GAP_HOURS=4
# Seed registry: py scripts/reddit_post_dry_run.py --seed
# Audit rules: py scripts/reddit_subreddit_audit.py SomeSub --save

# --- Market intel (Erome browse + Reddit JSON probe) ---
# TBCC_EROME_BROWSE_INTEL_ENABLED=1
# TBCC_EROME_BROWSE_INTEL_RANK=1          # boost export_flywheel pool picks by tag overlap
# TBCC_EROME_BROWSE_INTEL_LOOKBACK_DAYS=30
# TBCC_EROME_BROWSE_INTEL_UPLOAD_HINTS=1  # warn on saturated tags at upload preflight
# TBCC_MARKET_INTEL_PROBE_ENABLED=1
# TBCC_MARKET_INTEL_PROBE_SUBREDDITS=erome,amateur_milfs
# Weekly intel cycle (Monday beat — aligns with ship-log tick)
# TBCC_MARKET_INTEL_CYCLE_ENABLED=1
# TBCC_MARKET_INTEL_CYCLE_WINDOW_DAYS=7
# TBCC_MARKET_INTEL_CYCLE_MIN_EROME_ROWS=50
# TBCC_MARKET_INTEL_CYCLE_MIN_REDDIT_ROWS=20
# TBCC_MARKET_INTEL_CYCLE_CONFIDENCE_MIN=0.65
# TBCC_MARKET_INTEL_CYCLE_WEEKDAY=1
# TBCC_MARKET_INTEL_CYCLE_HOUR=9
# TBCC_MARKET_INTEL_CYCLE_MINUTE=5
# TBCC_MARKET_INTEL_AUTO_POST=0
# observe | queue (Buffer addToQueue when cycle complete)
# TBCC_MARKET_INTEL_CYCLE_POOL_ID=

# TBCC_DISCORD_LISTENING_RELAY_WEBHOOK_URL=
# Public invite pasted into Discord mirror captions (auto-linkifies in webhook messages)
# TBCC_AOF_DISCORD_INVITE_URL=https://discord.gg/N6bfTABan
# Forum channel webhooks need a thread name (creates a post in the forum):
# TBCC_DISCORD_WEBHOOK_THREAD_NAME=AOF Promo

# --- Daily AOF landing bulletin (Celery Beat, UTC hour) — referrals + milestone copy ---
# TBCC_LANDING_BULLETIN_CHAT_ID=-100xxxxxxxxxx
# Optional forum topic id if the “landing” lives in a topic:
# TBCC_LANDING_BULLETIN_MESSAGE_THREAD_ID=12345
# TBCC_LANDING_BULLETIN_HOUR_UTC=14
# TBCC_LANDING_BULLETIN_BOT_USERNAME=YourBotName
# Optional: full intro (multiline). If unset, a default AOF blurb is used.
# TBCC_LANDING_BULLETIN_INTRO=🔥 Welcome...\n\nLine two...

# --- Network liveness (automated perceived activity on main + faster lane cadences) ---
# TBCC_LIVENESS_THIN_INTERVAL_MIN=120          # GOON/BOP/ABG content schedulers
# TBCC_LIVENESS_ESTABLISHED_INTERVAL_MIN=180   # other content lanes
# TBCC_LIVENESS_HEARTBEAT_INTERVAL_MIN=240     # main-group pulse posts
# TBCC_LIVENESS_DROP_TICKER_INTERVAL_MIN=150
# TBCC_LIVENESS_COMMAND_INTERVAL_MIN=2880      # /loot · /subscribe · /referral rotation (48h)
# TBCC_LIVENESS_POOL_BACKUP_INTERVAL_MIN=90    # extra pool auto-posts when inventory exists
# Re-wire AOF PACKS seed scheduler after pack-pool URL inserts (default off — use wire script or API).
# TBCC_PACK_POOL_AUTO_WIRE=0
# TBCC_LIVENESS_MILESTONE_FOMO_HOURS=6         # Beat: milestone line to main group
# TBCC_LIVENESS_DROP_SIGNALS_PUBLIC=1          # Phase 1: public "this lane is thin" drop-signal posts.
#                                              # Set 0 to stop them, THEN re-run the liveness install
#                                              # (POST growth-hub install / dashboard) — that pass pauses
#                                              # existing rows (reversible via sentinel) and stops creating
#                                              # new ones. Pair with TBCC_THIN_POOL_BACKFILL_ENABLED=1 below
#                                              # for the intended internal replacement (see Phase 1 note).
# TBCC_LIVENESS_MESSAGE_THREAD_ID=              # Fixed topic (off when random topics on)
# TBCC_LIVENESS_RANDOM_TOPICS=1                 # Rotate liveness into lane subtopics
# TBCC_TOPIC_MIRROR_ENABLED=1                   # Storage Hub topic → main supergroup topic
# TBCC_STORAGE_POOL_SEED_ENABLED=0              # Beat: import small batches from Storage Hub → channel pools
# TBCC_STORAGE_POOL_SEED_BATCH=8                # Items per topic per seed run (milf, abg, big_tits, …)
# TBCC_STORAGE_POOL_SEED_HOURS=4                  # Beat interval (every N hours at :40 UTC)
# TBCC_WATCHDOG_CELERY_BACKLOG=200              # Dedupe run_schedule when home celery queue ≥ this
# TBCC_WATCHDOG_IMPORT_PRIORITY_THRESHOLD=3     # Purge thumbnail_warm when ≥N open import jobs
# TBCC_THUMBNAIL_WARM_PAUSE_WHEN_IMPORTS=1      # Skip enqueueing thumbnail_warm while imports wait
# TBCC_THIN_POOL_BACKFILL_ENABLED=0            # Phase 1: Beat (every 4h, ops_growth queue) — import Storage
#                                              # Hub content only into lanes below the network-median depth
#                                              # (pending+approved). Internal alternative to public drop signals.
#                                              # Shares the global Telegram account lock with posting — keep opt-in.
# TBCC_STORAGE_DEPOSIT_MEDIA_TYPES=both       # /deposit in Storage Hub (videos|photos|both)
# TBCC_STORAGE_DEPOSIT_INDEX_ONLY=1           # Fast /deposit: index in-chat refs (bytes load on dashboard preview)
# TBCC_STORAGE_SENT_CACHE_ENABLED=1           # Move deposited media → SENT CACHE subtopic (removes from lane topic)
# TBCC_STORAGE_SENT_CACHE_TOPIC_ID=12345      # t.me/c/3812457581/12345 — caption stamp ✅ + category emoji
# TBCC_STORAGE_SENT_CACHE_SEC_PER_ITEM=2     # Extra Celery timeout budget per item when moving to cache
# TBCC_CHANNEL_IMPORT_SEC_PER_INDEX=3         # Timeout budget per item when index-only (15 videos ≈ 6m)
# TBCC_STORAGE_DEPOSIT_AUTO_APPROVE=1         # Approve Storage Hub → pool imports (ready for schedulers)
# TBCC_STORAGE_DEPOSIT_AUTO_APPROVE_REQUIRES_CLIP=0  # 1 = legacy: wait for CLIP tags before approve
# TBCC_DEPOSIT_TOPIC_MIRROR=1                   # 0 = /deposit pool only, skip deferred main-group mirror
# TBCC_TELETHON_DISCONNECT_IMPORT_AFTER_IO=1    # Release import Telethon session after I/O (reduces lock storms)
# TBCC_ENRICH_ON_IMPORT=0                     # Kill switch: no NSFW/CLIP/Lustpress/LLM enrich on import (recommended for /deposit)
# TBCC_SECRETARY_STORAGE_DEPOSIT=0            # /deposit moved to Album Composer (default)
# TBCC_ALBUM_COMPOSER_STORAGE_DEPOSIT=1       # /deposit + depositstaged in Storage Hub
# TBCC_ADMIN_BOT_STORAGE_DEPOSIT=0            # Telethon admin_bot /deposit off by default
# TBCC_STORAGE_HUB_ALLOW_CHANNEL_POST=1         # allow /deposit when posting as Storage & Bot Hangar (anonymous admin)
# TBCC_CHANNEL_IMPORT_MAX_SCAN=2000             # Max messages scanned per job when hunting N new items
# TBCC_LIVENESS_CHECKOUT_STARS=1                # Pay ⭐ inline button on main-group liveness posts
# TBCC_DROP_COUNTDOWN_ENABLED=1                 # Edit-in-place drop ticker (60→45→…→1→live album)
# TBCC_FEED_RHYTHM_ENABLED=1                    # Auto media burst after N text-only posts on main group
# TBCC_FEED_RHYTHM_TEXT_STREAK=3
# TBCC_FEED_RHYTHM_COOLDOWN_MIN=75

# --- OpenRouter (https://openrouter.ai/keys) — OpenAI-compatible chat API ---
# One key powers secretary, caption rewrite, format engine, LLM chat bot, and optional vision gap-fill.
# Model catalog: https://openrouter.ai/models (e.g. free Venice Dolphin below).
# TBCC_LLM_PROVIDER=openrouter
# TBCC_OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_API_KEY=                    # alternate env name
# TBCC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TBCC_OPENROUTER_REFERER=https://tbcc.local
# TBCC_OPENROUTER_TITLE=TBCC
# Default text model when TBCC_LLM_MODEL unset:
# TBCC_OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
# TBCC_LLM_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
# Paid Venice (uncensored) — drop :free suffix once OpenRouter credits are loaded.
# TBCC_LLM_CHAT_OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
# Per-feature overrides still work, e.g. TBCC_SECRETARY_LLM_MODEL=..., TBCC_CAPTION_LLM_REWRITE_MODEL=...
# LLM Telegram bridge only: TBCC_LLM_CHAT_PROVIDER=openrouter

# --- Free-only chat CLI (OpenRouter :free — preferred; Featherless is paid now) ---
# Default: scripts/tbcc-uncensored-chat.ps1 → openrouter + dolphin/hermes :free (no bill).
# Dolphin Venice :free sunset ~2026-07-19 on OpenRouter; CLI auto-falls back to Hermes / openrouter/free.
#   .\scripts\tbcc-uncensored-chat.ps1
#   .\scripts\tbcc-uncensored-chat.ps1 -ListFree
#   .\scripts\tbcc-uncensored-chat.ps1 -Model nousresearch/hermes-3-llama-3.1-405b:free
# Paid hosts (opt-in only): -AllowPaid -Provider featherless|venice
# TBCC_FEATHERLESS_API_KEY=
# TBCC_VENICE_API_KEY=
# Any other OpenAI-compatible host:
# TBCC_LLM_PROVIDER=custom
# TBCC_LLM_BASE_URL=https://your-proxy.example/v1
# TBCC_LLM_API_KEY=

# --- LLM (Dashboard → shop AI, Media Library “AI suggest”) ---
# OpenAI (when TBCC_LLM_PROVIDER=openai): https://platform.openai.com/api-keys
# TBCC_OPENAI_API_KEY=
# OPENAI_API_KEY=
# TBCC_LLM_MODEL=gpt-4o-mini

# Vision auto-tag on import (Celery): Lustpress metadata + NSFW classifier + conservative LLM fallback.
# Requires Redis + Celery worker. LLM needs TBCC_OPENAI_API_KEY.
# API dev only: set to 1 to run uvicorn with --reload (can leave orphan workers on Windows; default is off).
# TBCC_UVICORN_RELOAD=0
#
# Stack profile: lean = API + Celery + Beat + payment + loot only (Docker PG/Redis).
# Skips dashboard, secretary, album_composer, celery_post*, celery_ops, openclaw, forum/macro/admin/companion, enrichment.
# Enable extras in tray Services. Full = previous "farm" cold-start.
# TBCC_STACK_PROFILE=lean
# After revenue-island cutover (dedicated VPS owns payment/loot tokens): keep home bots Off so Start never 409s.
# TBCC_REVENUE_ISLAND_ACTIVE=1
# Also set .tbcc-run/service-toggles.json payment/loot to false (see docs/REVENUE_ISLAND.md cutover).
# TBCC_SKIP_ENRICHMENT=1

# Fast import: POST /import/bytes returns job_id immediately; Celery telegram queue uploads to Saved Messages.
# TBCC_FAST_IMPORT=1
# TBCC_IMPORT_MAX_BYTES=524288000
# TBCC_IMPORT_TELEGRAM_TIMEOUT_S=600
# Use staged poster frame for NSFW classify (avoids re-download from Telegram). TBCC_CLASSIFY_USE_STAGED_BYTES=1
# Force synchronous import (legacy): TBCC_FAST_IMPORT=0 or form field sync=true
# TBCC_ENRICH_ON_IMPORT=0                     # Kill switch: no NSFW/CLIP/Lustpress Telethon enrich (recommended for /deposit)
# TBCC_AUTO_TAG_ON_IMPORT=1                   # LLM vision tags only (does NOT enable NSFW/CLIP sidecars unless sidecar URLs set)

# Promo text watermark (Pillow images + ffmpeg video) on import/upload/send and gallery export via POST /import/watermark-bytes
# Dashboard: Media Library → Import from Saved → Promo watermark settings (GET/PATCH /watermark-settings)
# Album Composer bot: /watermark — per-draft text/opacity/color; burns in on send when apply_on_album_composer=1
# TBCC_WATERMARK_ENABLED=1
# TBCC_WATERMARK_TEXT=telegram.me/aofmainhub
# TBCC_WATERMARK_TEXT_SECONDARY=
# TBCC_WATERMARK_TEXT_TERTIARY=
# TBCC_WATERMARK_COLOR=#ffffff
# TBCC_WATERMARK_STRIP_PREVIOUS=0
# Set to 1 only when re-watermarking images that already have promo text burned in (blurs top/bottom edge bands first).
# TBCC_WATERMARK_MODE=rotate
# TBCC_WATERMARK_POSITION=bottom_right
# TBCC_WATERMARK_OPACITY=0.70
# TBCC_WATERMARK_SIZE_RATIO=0.045   # larger burn-in for Erome traffic (default was 0.030)
# TBCC_WATERMARK_MARGIN_PX=10
# TBCC_WATERMARK_MAX_VIDEO_MB=250
# TBCC_WATERMARK_FONT_PATH=C:/Windows/Fonts/arial.ttf
# After burn-in, rename file to: YYYYMMDD · TG@AOFMAINHUB · {content} · allmylinks.comaof69 · {tail}.ext
# TBCC_WATERMARK_BRAND_RENAME=1
# Per-request opt-out: form skip_watermark=true on POST /import/bytes, or gallery Options → Skip AOF promo watermark

# Headless Perchance T2I (scripts/run_perchance_headless.py)
# TBCC_PERCHANCE_OUT_DIR=
# TBCC_PERCHANCE_USER_KEY=
# TBCC_PERCHANCE_USER_KEY_FILE=
# TBCC_PERCHANCE_CHANNEL=ai-text-to-image-generator
# TBCC_PERCHANCE_SUBCHANNEL=public
# Dashboard thumbnails: API serves disk cache only (default). Celery telegram worker warms misses.
# TBCC_THUMBNAIL_API_TELEGRAM=0
# Legacy: inline Telegram fetch from API on cache miss (contends with admin.session — avoid).
# TBCC_THUMBNAIL_API_TELEGRAM=1
# TBCC_THUMBNAIL_FETCH_CONCURRENCY=2
# TBCC_THUMBNAIL_FETCH_TIMEOUT_S=45
# Per-pool Curate gallery (Dashboard → Curate): page size for infinite scroll (default 24, max 60).
# TBCC_GALLERY_PAGE_SIZE=24
# TBCC_AUTO_TAG_LLM_FALLBACK=1
# TBCC_AUTO_TAG_LLM_ALWAYS=0
# Optional max edge for downscaled image sent to OpenAI (default 1024)
# TBCC_AUTO_TAG_MAX_EDGE=1024

# Local NSFW classifier (TheHamkerCat/NSFW_Detection_API): GET ?url=…
# Run: docker-compose up -d in that repo, then point TBCC at it.
# TBCC_NSFW_DETECT_URL=http://127.0.0.1:8001
# TBCC_NSFW_DETECT_MIN_CONF=0.55
# Optional clone path (default: tbcc/services/NSFW_Detection_API) — start.ps1 -Full starts python -m api
# TBCC_NSFW_DETECT_DIR=C:/path/to/NSFW_Detection_API

# Lustpress metadata for video page URLs (self-hosted Bun/Elysia scraper)
# TBCC_LUSTPRESS_URL=http://127.0.0.1:3000
# Optional clone path (default: tbcc/services/lustpress) — start.ps1 -Full starts bun run start:dev
# TBCC_LUSTPRESS_DIR=C:/path/to/lustpress

# After vision auto-tag (or tag rule re-apply): assign media.pool_id from pools with route rules.
# Each pool may set comma-separated tag slugs (tbcc_tags.slug) and/or NSFW tiers (sfw,suggestive,explicit,unknown).
# If both are set on a pool, BOTH must match. Tier-only or slug-only rules are allowed. Lower route_priority wins.
# Only when pool_id is unset unless TBCC_AUTO_ROUTE_OVERWRITE=1.
# TBCC_AUTO_ROUTE_POOL=1
# TBCC_AUTO_ROUTE_OVERWRITE=0

# Local OpenAI-compatible API key (LM Studio, Ollama with auth, etc.) — for future use or custom tooling.
# TBCC_LOCAL_LLM_API_KEY=
# Optional base URL when the backend supports pointing chat completions at localhost (not wired yet).
# TBCC_LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1

# --- Automatic crypto (NOWPayments) + generic payment webhooks ---
# When all required vars are set, GET /health returns "crypto_auto_checkout": true and the payment bot shows
# Wallet/crypto users a hosted pay link; POST /webhooks/nowpayments fulfills orders (no dashboard mark-paid).
#
# 1) TBCC_PUBLIC_API_BASE_URL — public https:// base of THIS API (no trailing slash). NOWPayments must reach
#    {TBCC_PUBLIC_API_BASE_URL}/webhooks/nowpayments — use ngrok/Cloudflare Tunnel in dev (not localhost).
# 2) TBCC_NOWPAYMENTS_API_KEY — from NOWPayments dashboard.
# 3) TBCC_NOWPAYMENTS_IPN_SECRET — same as “IPN secret” in NOWPayments; must match what they send in X-NOWPAYMENTS-SIG.
# 4) In NOWPayments, set the IPN callback URL to: {TBCC_PUBLIC_API_BASE_URL}/webhooks/nowpayments
# 5) TBCC_INTERNAL_API_KEY — must match on payment bot so POST /external-payment-orders/ succeeds.
#
# TBCC_PUBLIC_API_BASE_URL=https://your-api.example.com
# TBCC_NOWPAYMENTS_API_KEY=
# TBCC_NOWPAYMENTS_IPN_SECRET=
# Optional: lock checkout to one currency/ticker (example: usdttrc20).
# Leave unset/empty to let NOWPayments hosted checkout offer broader supported currencies.
# TBCC_NOWPAYMENTS_USE_INVOICE=1          # Hosted page: buyer picks TON/BTC/USDT/etc (recommended)
# TBCC_NOWPAYMENTS_PAY_CURRENCY=           # Leave empty with invoice mode; set e.g. trx only for fixed-coin deposit
# TBCC_NOWPAYMENTS_MIN_CHECKOUT_USD=0        # 0 = bill catalog USD; raise only if NP rejects small invoices
# Optional: POST /webhooks/instant-payment with Authorization: Bearer <secret> JSON {"reference_code":"EPO-…"}
# TBCC_PAYMENT_WEBHOOK_SECRET=
#
# --- My.JDownloader (optional — gallery Crawl tab fallback + Send to JDownloader) ---
# Create credentials at https://my.jdownloader.org/ (App password recommended).
# JDownloader desktop must be running with My.JDownloader remote access enabled.
# TBCC_MYJD_EMAIL=
# TBCC_MYJD_PASSWORD=
# TBCC_MYJD_DEVICE_NAME=              # optional; first linked device if empty
# TBCC_MYJD_ENABLED=1
# TBCC_MYJD_POLL_TIMEOUT_S=120        # max wait for linkgrabber crawl
# TBCC_MYJD_REQUEST_TIMEOUT_S=45       # hard cap per MyJD API call (prevents hung backend)
# TBCC_MYJD_MAX_LINKS_PER_BATCH=40     # chunk large gallery sends into smaller JD packages
# TBCC_MYJD_ASYNC=1                    # always queue add-links via Celery (recommended)
# TBCC_MYJD_ASYNC_MIN_LINKS=12         # auto-queue when payload has this many URLs or more
# TBCC_CRAWLER_MYJD_MODE=auto           # auto | always | never — when to use JD after local crawl
# Point JD default download folder at TBCC_WATCH_INBOX (see below) for hands-free ingest.
#
# --- Download inbox organizer (watch-folder auto categorization) ---
# Point downloader / Chrome Downloads output to TBCC_WATCH_INBOX, then run:
#   cd tbcc/backend && python -m app.services.watch_folder_organizer
# One-shot:
#   cd tbcc/backend && python -m app.services.watch_folder_organizer --once
# Dry-run:
#   cd tbcc/backend && python -m app.services.watch_folder_organizer --once --dry-run
# Extension "Save AOF" writes under Downloads/tbcc/inbox/ (configurable via chrome.storage
# tbccWatchInboxPrefix). Set Chrome Downloads folder so that path == TBCC_WATCH_INBOX,
# or junction Downloads/tbcc/inbox → your inbox.
# TBCC_WATCH_INBOX=C:/Users/you/Downloads/tbcc/inbox
# Lane destinations live under AOF NETWORK (one folder per channel: AOF MILFGILF, AOF BIG TITS, …):
# TBCC_WATCH_LIBRARY=C:/Users/you/Downloads/tbcc/AOF NETWORK
# Flat AOF lane folders from sidecar/page tags — default ON, low-CPU (no CLIP):
# TBCC_WATCH_AOF_LANE_FOLDERS=1
# Folder name style: emoji (🍒 AOF BIG TITS, default) | disk (AOF MILFGILF under AOF NETWORK)
# TBCC_WATCH_AOF_FOLDER_STYLE=emoji
# For the Downloads/tbcc/AOF NETWORK channel tree, use:
# TBCC_WATCH_AOF_FOLDER_STYLE=disk
# Watermark + AOF rename bare inbox drops when sidecar aof_preprocessed is not set — default ON:
# TBCC_WATCH_AOF_PREPROCESS=1
# TBCC_WATCH_DEBOUNCE_S=1.5
# Wait before moving and verify size/mtime stability (prevents moving partial files).
# TBCC_WATCH_STABLE_WAIT_S=2.0
# Keep only Images/Videos in the watch pipeline (all other categories are treated as non-media).
# TBCC_WATCH_MEDIA_ONLY=1
# Optional destination for non-media when TBCC_WATCH_MEDIA_ONLY=1.
# If unset, non-media files are skipped and remain in inbox.
# TBCC_WATCH_REJECT_DIR=C:/Users/you/Downloads/tbcc_rejected
# Optional extension→category override map (comma-separated):
# ".cbz=Archives,.nfo=Documents,.jpeg=Images"
# Categories: Images, Videos, Audio, Archives, Documents, LinkLists, Playlists, Other
# TBCC_WATCH_CATEGORY_OVERRIDES=.cbz=Archives,.nfo=Documents
# TBCC_WATCH_LOG=C:/Users/you/Downloads/tbcc_watch_log.jsonl
# NSFW image subfolders under Images/ (legacy; ignored when TBCC_WATCH_AOF_LANE_FOLDERS=1):
# TBCC_WATCH_NSFW_TIER_SUBFOLDERS=0
# TBCC_WATCH_NSFW_CLASS_SUBFOLDERS=0
# Optional vision LLM sidecars (*.tbcc-meta.json) with niche/act/body_type facets (OpenAI cost per file):
# TBCC_WATCH_LLM_TAG=1

# --- Local CLIP niche categorizer (OpenCLIP ViT-B/32, port 8002) ---
# Fixed category list: image embedding vs precomputed text embeddings (zero-shot, no LLM vision).
# Point at your ~1400-category JSON/txt; first run encodes prompts (~few min CPU, cached as .clip_embeddings.npz).
# Optional Hugging Face token for faster model downloads / higher rate limits (read-only is enough):
# HF_TOKEN=hf_xxxxxxxx
# TBCC_CLIP_CATEGORIZE_URL=http://127.0.0.1:8002
# TBCC_CLIP_CATEGORIES_FILE=C:/path/to/your/categories.json
# TBCC_CLIP_MIN_CONF=0.08
# TBCC_CLIP_MIN_MARGIN=0.02
# TBCC_CLIP_PROMPT_TEMPLATE=a photo of {label}
# Third-level niche folders under Images/{tier}/{class}/ (default on when CLIP URL is set):
# TBCC_WATCH_CLIP_NICHE_SUBFOLDERS=1

# --- Vision LLM gap-fill (only when CLIP confidence is low) ---
# Providers: none | openai | openrouter | ollama
# TBCC_VISION_LLM_PROVIDER=openrouter
# TBCC_VISION_LLM_ON_LOW_CLIP=1
# TBCC_OPENROUTER_API_KEY=
# TBCC_OPENROUTER_VISION_MODEL=google/gemma-3-12b-it:free
# TBCC_OLLAMA_BASE_URL=http://127.0.0.1:11434
# TBCC_OLLAMA_VISION_MODEL=llava
# TBCC_VISION_LLM_MODEL=   # override model for any provider

# --- Focus profiles (stop optional services without full stack shutdown) ---
# API: GET/POST http://127.0.0.1:8000/ops/focus — dashboard banner + tray supervisor
# TBCC_FOCUS_AUTO_REACT=1          # auto-apply telegram_relief on session lock storm
# TBCC_FOCUS_AUTO_IMPORT=1         # auto import_burst on fast import + queue spike
# TBCC_FOCUS_IMPORT_JOBS_THRESHOLD=2
# TBCC_FOCUS_IMPORT_IDLE_RESTORE_MIN=15
# TBCC_FOCUS_LOCK_EVENTS_THRESHOLD=3
# TBCC_FOCUS_LOCK_WINDOW_S=120
# TBCC_FOCUS_IDLE_RESTORE_MIN=20   # auto-restore telegram_relief after calm period (legacy)
# TBCC_FOCUS_TELEGRAM_RELIEF_RESTORE_MIN=5   # auto-restore once lock storm subsides
# TBCC_HEALTH_AUTO_REMEDIATE=1             # banner fixes without clicks (restore focus, resume post queue, start workers)

# --- Ops alerts (toast / tray / extension notifications) ---
# TBCC_ALERTS_ENABLED=1
# TBCC_ALERTS_PAYMENT_TOAST=1        # flash toasts for sales + pending checkout (dashboard/extension)
# TBCC_ALERTS_HUB_SCAN=1             # 1 = ingest error-hub.log into Secretary /ops inbox
# TBCC_ALERTS_HUB_TOAST=0            # 1 = desktop toasts for error-hub (off by default — noisy)
# TBCC_ALERTS_OPS_TOAST=0            # 1 = toast critical ops inbox events (off by default)
# TBCC_ALERTS_HUB_CRITICAL_ONLY=1    # 1 = hub scan pushes critical only (skip generic warnings)
# TBCC_ALERTS_DEDUP_TTL_S=1800     # suppress repeat of same alert for 30m
# TBCC_ALERTS_HUB_FROM_START=0     # 1 = scan full log on first poll (not recommended)
# TBCC_ALERTS_HUB_MAX_PER_POLL=1   # max hub toasts returned per poll (when HUB_TOAST=1)
# TBCC_ALERTS_HUB_CATCHUP_TAIL=3     # backlog catch-up: only tail N lines, collapsed to one toast
# TBCC_ALERTS_MAX_TOASTS_PER_2MIN=1    # non-payment desktop toasts per 2min (0=off); live tweak: Secretary /toasts
# TBCC_ALERTS_CLIENT_MIN_INTERVAL_S=120  # legacy fallback if Redis window unavailable
# TBCC_BACKEND_RESTART_GRACE_S=120   # suppress ops toasts while TBCC-Backend is restarting
# TBCC_BACKEND_RESTART_GRACE_TAIL_S=20  # short tail after /health OK (straggler hub lines)

# --- Cursor agent triage (optional — costs agent quota; diagnose-only by default) ---
# pip install cursor-sdk   # optional; Copy-for-Cursor works without it
# TBCC_CURSOR_TRIAGE_ENABLED=0
# CURSOR_API_KEY=            # or TBCC_CURSOR_API_KEY
# TBCC_CURSOR_TRIAGE_MAX_PER_DAY=3
# TBCC_CURSOR_TRIAGE_AUTO_FIX=0   # 1 = agent may apply safe fixes (not recommended live)
# TBCC_CURSOR_TRIAGE_PR_ONLY=1    # 1 = auto-fix must branch + PR; never push main (default on)
# TBCC_CURSOR_TRIAGE_AUTO_FIX_ALLOWLIST=session_sqlite_lock,uvicorn_orphans
# TBCC_CURSOR_TRIAGE_MODEL=composer-2.5
# TBCC_CURSOR_TRIAGE_ALLOWLIST=session_lock_storm,service_traceback,worker_crash,api_port_duplicate
# TBCC_REPO_ROOT=               # repo root for cursor-sdk local runs (defaults to tbcc parent)
# API: GET /ops/triage/status · GET /ops/triage/bundle/{id} · POST /ops/triage/run
# See tbcc/docs/CURSOR_OPS_AUTOMATION.md for scheduled Cursor Automation draft

# --- Content performance + growth attribution (views, caption slots, conversions) ---
# TBCC_ANALYTICS_TZ=America/New_York
# TBCC_CONTENT_PERFORMANCE_ENABLED=1
# TBCC_GROWTH_ATTRIBUTION_ENABLED=1
# TBCC_GROWTH_ATTRIBUTION_LOOKBACK_HOURS=6
# TBCC_VIEW_REFRESH_LOOKBACK_DAYS=14
# TBCC_VIEW_REFRESH_BEAT_ENABLED=1
# TBCC_VIEW_REFRESH_BEAT_MINUTES=30
# TBCC_VIEW_REFRESH_OFFPEAK_HOURS_ET=2,3,4,5
# TBCC_VIEW_REFRESH_TELEGRAM_SESSION=admin_poster_views
#
# Analytics-driven export flywheel (observe 1–2 weeks, then auto)
# TBCC_EXPORT_FLYWHEEL_ENABLED=1
# TBCC_EXPORT_FLYWHEEL_MODE=observe
# TBCC_EXPORT_FLYWHEEL_RANK_PICKS=1
# TBCC_EXPORT_FLYWHEEL_TICK_MINUTES=15
# TBCC_EXPORT_FLYWHEEL_DAILY_CAP_PER_LANE=6
# TBCC_EXPORT_FLYWHEEL_REQUIRE_MIN_VIEWS_SAMPLE=5
# TBCC_POOL_EROME_MIRROR=0   # pool Telegram post → Erome teaser album (view monetization)
# TBCC_POOL_BUFFER_MIRROR=0   # pool post → X with SFW promo image + Erome URL + Telegram invite (flywheel)
#
# Idle Service Governor (Phase 3) — run optional background ticks only when signals warrant.
# Opt-in. While OFF the gate is a pass-through (no behavior change). The tick evaluates signals
# every TBCC_IDLE_GOVERNOR_INTERVAL_S and marks each service active/idle; governed Beat tasks
# (export_flywheel, listening_relay, erome_view_sync) return {"skipped": "governed_idle"} when
# idle. NOTE: (1) governance only idles/wakes tasks Beat REGISTERED at startup (their *_ENABLED=1)
# — to bring one under governance, set *_ENABLED=1 and restart Beat once; (2) the governor tick
# runs inside the focus watch loop (on by default; off only if both TBCC_FOCUS_AUTO_REACT=0 and
# TBCC_FOCUS_AUTO_IMPORT=0), else the governor stays dormant and the gate fail-opens (no change).
# income_poll is NOT governed (default-on, no wake signal).
# TBCC_IDLE_GOVERNOR_ENABLED=0
# TBCC_IDLE_GOVERNOR_INTERVAL_S=300      # signal eval cadence (60–3600); gate reads are cheap
# TBCC_IDLE_FLYWHEEL_MINUTES=1440        # stay active this long after last export proposal
# TBCC_IDLE_LISTENING_RELAY_MINUTES=30   # stay active this long after dashboard relay toggle off
# TBCC_IDLE_EROME_VIEW_SYNC_MINUTES=4320 # stay active this long after last erome album upload
# TBCC_BUFFER_METRICS_SYNC_ENABLED=1
# SENT CACHE composer — after /deposit, bundle cache items into albums (default 5), main group + Erome
# TBCC_SENT_CACHE_COMPOSER_ENABLED=1
# TBCC_SENT_CACHE_ALBUM_SIZE=5
# TBCC_SENT_CACHE_COMPOSER_REBUNDLE_CACHE=1
# TBCC_SENT_CACHE_COMPOSER_MAIN_GROUP=1
# TBCC_SENT_CACHE_COMPOSER_EROME=1
# TBCC_SENT_CACHE_COMPOSER_COUNTDOWN_S=8
# TBCC_GROWTH_TICK_SKIP_EMPTY=1
# TBCC_GROWTH_TICK_MIN_REFRESHABLE_DELIVERIES=3
# TBCC_GROWTH_TICK_MIN_VIEW_ROWS=3
# TBCC_GROWTH_SIGNALS_ENABLED=1
# TBCC_SIGNAL_LOOKBACK_DAYS=14
# TBCC_SIGNAL_MIN_POSTS_PER_HOUR=3
# Signals: GET /analytics/signals · POST /analytics/signals/tick
# --- TBCC flywheel tick (internal event bus — NOT github.com/openclaw/openclaw) ---
# TBCC_FLYWHEEL_GROWTH_TICK=1
# TBCC_FLYWHEEL_AUTO_TICK=0
# Script: tbcc/scripts/run-tbcc-flywheel-tick.ps1
# API: POST /analytics/tbcc-flywheel/tick
# Real OpenClaw gateway: tbcc/docs/OPENCLAW_TBCC_INTEGRATION.md

# --- Ops flywheel (skill registry + Secretary approval) ---
# TBCC_FLYWHEEL_ENABLED=1
# TBCC_FLYWHEEL_APPROVAL=1     # 1 = destructive lanes need Approve in Secretary
# Deprecated flywheel env aliases: TBCC_OPENCLAW_GROWTH_TICK, TBCC_OPENCLAW_AUTO_TICK
# OpenClaw gateway auto-start (external): TBCC_OPENCLAW_AUTO_START=1, TBCC_OPENCLAW_GATEWAY_PORT=18789
# OpenClaw (external setup): tbcc/scripts/setup-openclaw-tbcc.ps1
# API: GET /ops/flywheel/status · POST /ops/flywheel/tick · POST /ops/flywheel/approve/{id}

# --- Link resolver (Bypass.vip / compatible API) + /resolve in payment bot ---
# Requires: Redis, Celery worker with queues link + link_priority (see infra/docker-compose worker_link),
# TBCC_INTERNAL_API_KEY on bot + API, and a premium API key from the provider.
# Docs pointer: https://api.bypass.vip/
#
# TBCC_BYPASS_API_KEY=
# Premium key from https://bypass.vip/premium (~$1 / 1000 bypasses).
# TBCC_BYPASS_FREE=1 — attempts GET /bypass?url=... (see github.com/bypass-vip/bypass.vip).
# As of 2026 the free API often returns a shutdown/discord message — premium key required
# for LV-gated channel scrapes. Paste/rentry/sophon/direct mega paths work without bypass.
# TBCC_BYPASS_FREE=0
# Set 0 to disable accepting new jobs (API returns 503 on POST /link-resolver/requests).
# TBCC_BYPASS_ENABLED=1
# TBCC_BYPASS_API_BASE_URL=https://api.bypass.vip
# Premium plans may use /v1; free tier uses /bypass (auto-selected when no API key).
# TBCC_BYPASS_API_PATH=/v1
# TBCC_BYPASS_HTTP_METHOD=GET
# TBCC_BYPASS_TIMEOUT_S=45
# Query param names if your plan uses different ones:
# TBCC_BYPASS_URL_QUERY_PARAM=url
# TBCC_BYPASS_KEY_QUERY_PARAM=key
# Global sliding window (protect provider rate limits; default ~8 per 10s):
# TBCC_BYPASS_GLOBAL_MAX_PER_WINDOW=8
# TBCC_BYPASS_GLOBAL_WINDOW_SEC=10
# Per-user hourly quotas (free vs premium tier from active subscriptions):
# TBCC_LINK_RESOLVER_FREE_PER_HOUR=15
# TBCC_LINK_RESOLVER_PREMIUM_PER_HOUR=120
# Payment bot poll timeout for /resolve (seconds):
# TBCC_LINK_RESOLVER_POLL_MAX_S=120

# --- Promo affiliate links (Misc picker): optional HTTP shortening ------------------------------
# Fill short_url via POST /promo-affiliate-links/{id}/shorten from the dashboard picker.
# isgd — free is.gd (subject to their limits); tinyurl — https://tinyurl.com/app/dev API token
# TBCC_PROMO_SHORTEN_PROVIDER=isgd
# TBCC_PROMO_SHORTEN_PROVIDER=tinyurl
# TBCC_TINYURL_API_TOKEN=
# Pixeldrain (ShareX-style): uploads the long URL as a small .txt via PUT /api/file/{name}; viewer URL is /u/{id}
# TBCC_PROMO_SHORTEN_PROVIDER=pixeldrain
# TBCC_PIXELDRAIN_API_KEY=
# Optional mirror (default https://pixeldrain.com/api):
# TBCC_PIXELDRAIN_API_BASE=https://pixeldrain.com/api
# Zip flywheel hybrid (gallery ZIP → POST /import/zip-flywheel):
# TBCC_ZIP_FLYWHEEL_R2_MAX_BYTES=41943040
# TBCC_ZIP_FLYWHEEL_MAX_BYTES=524288000
# TBCC_ZIP_FLYWHEEL_R2_PREFIX=packs/flywheel

# --- Gravatar (profile cards / REST API) ---------------------------------------------------------
# Bearer token from https://gravatar.com/developers — server-side only (never in extension/dashboard bundle).
# oEmbed: GET https://api.gravatar.com/v3/oembed?url=https://gravatar.com/{username}
# Docs: https://docs.gravatar.com/embedding-profile-card/
# TBCC_GRAVATAR_API_KEY=
# Optional default profile for embeds (username only, no @):
# TBCC_GRAVATAR_PROFILE_USERNAME=
