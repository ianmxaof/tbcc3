# Optional override for who receives drafts (defaults to ADMIN_TELEGRAM_ID):
# TBCC_SECRETARY_SUGGEST_NOTIFY_CHAT_ID=
# Admin inbox (same secretary bot token — payment, loot, ops, pending invoices):
# TBCC_INBOX_ENABLED=1
# TBCC_INBOX_INSTANT=critical            # instant DM for ops errors (critical by default)
# TBCC_INBOX_INSTANT=critical,important  # also ping important (manual pending checkout, etc.)
# TBCC_INBOX_INSTANT_SALES=1             # instant DM on every completed sale (Stars/crypto/pack/loot key)
# Public FOMO (no buyer PII) → Telegram network + Buffer/X on every fulfilled sale:
# TBCC_SALE_ANNOUNCE_ENABLED=1
# TBCC_SALE_ANNOUNCE_TARGETS=network,buffer   # network|main|buffer (comma-separated)
# TBCC_SALE_ANNOUNCE_SKIP_KEYS=               # omit network keys (leave empty — hub is Loot Room)
# TBCC_SALE_ANNOUNCE_BUFFER_MODE=addToQueue     # addToQueue | shareNow
# TBCC_SALE_ANNOUNCE_MIN_INTERVAL_S=45        # per-kind throttle (0 = every sale)
# TBCC_SALE_ANNOUNCE_STAGGER_S=8              # seconds between network channel queue ticks
# Instant DMs use HTTP + TBCC_SECRETARY_BOT_TOKEN — secretary_bot process optional for pings (needed for /inbox callbacks).
# Commands (admin DM only): /inbox /now /payment /loot /ops /critical /read /status /relief /focus /triage
# Instant ops alerts include inline buttons (relief · copy · agent) when enabled:
# TBCC_INBOX_OPS_ACTIONS=1
# Pending wallet/crypto checkout pings include Approve / Deny when enabled:
# TBCC_INBOX_INVOICE_ACTIONS=1
# TBCC_WT_CLOSE_TAB=0            # default: tabs close when service shell exits (no wt close-tab — avoids 0x80070002 storms)
# TBCC_WT_CLOSE_TAB=1            # opt-in wt.exe close-tab (only if shell-kill is insufficient)
# All WT service tabs use run-tbcc-service.ps1 (self-closing). Never cmd /k for stack tabs.
# TBCC_WT_LAUNCH_MINIMIZED=1     # default: new TBCC WT windows start minimized (cold start does not steal focus)
# TBCC_WT_LAUNCH_MINIMIZED=0     # allow new WT windows to open in the foreground
# TBCC_WT_MONOLITH=1             # default: auto-restarts reuse the single TBCC WT host (no hidden PS popups)
# TBCC_WT_MONOLITH=0             # allow headless Background restarts when TBCC_BACKGROUND_SERVICE_START=1
# TBCC_WT_NEW_TAB_BACKGROUND=1   # default: adding a tab to the existing WT host keeps a minimized host minimized (no focus steal on restart)
# TBCC_WT_NEW_TAB_BACKGROUND=0   # let Windows Terminal foreground the host window when a service tab is (re)opened
# TBCC_EMOJI_FACTORY_ORPHAN_GRACE_MINUTES=15  # kill stray httpx emoji-factory one-liners older than this
# TBCC_INBOX_HUB_BATCH_PREVIEW_LINES=5 # lines shown in batch digest
# Format Engine (FE-LLMv4): persistent emotional context + adaptive support formats (default on).
# TBCC_FORMAT_ENGINE_ENABLED=1
# TBCC_FORMAT_ENGINE_VERBOSITY=compact
# TBCC_SECRETARY_PUBLIC_FAQ=0
# TBCC_FORMAT_ENGINE_MESSAGE_RETENTION=80
# TBCC_FORMAT_ENGINE_LLM_HISTORY=8
# LLM emotion refine when interaction phase changes (requires OpenAI key):
# TBCC_FORMAT_ENGINE_LLM_REFINE=0
# FAQ RAG for secretary bot (keyword scoring; optional embeddings):
# TBCC_SECRETARY_RAG_ENABLED=1
# TBCC_SECRETARY_RAG_TOP_K=4
# TBCC_SECRETARY_RAG_EMBEDDINGS=0
# TBCC_SECRETARY_RAG_EMBEDDING_MODEL=text-embedding-3-small
# TBCC_SECRETARY_SYSTEM_PROMPT_EXTRA=
